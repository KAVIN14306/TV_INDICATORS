type bbOb
    float top       = na
    float btm       = na
    int   loc       = bar_index
    bool  breaker   = false
    int   break_loc = na

type bbSwing
    float y       = na
    int    x       = na
    bool  crossed = false

var array<bbOb> bbBullishObs = array.new<bbOb>(0)
var array<bbOb> bbBearishObs = array.new<bbOb>(0)

bbSwings(int len) =>
    var os = 0
    var bbSwing t = bbSwing.new(na, na)
    var bbSwing b = bbSwing.new(na, na)

    upper = ta.highest(len)
    lower = ta.lowest(len)

    os := high[len] > upper ? 0 : low[len] < lower ? 1 : os

    if os == 0 and os[1] != 0
        t := bbSwing.new(high[len], bar_index[len])

    if os == 1 and os[1] != 1
        b := bbSwing.new(low[len], bar_index[len])

    [t, b]

method bbNoTransp(color css) => color.rgb(color.r(css), color.g(css), color.b(css))

// Updates one slot's pooled box/line/label objects in place instead of deleting and recreating them.
// Only called for breakers (see the Draw block), so the else branch is a fallback that is never reached.
method bbApply(bbOb id, box boxA, box boxB, line lineTop1, line lineBtm1, line lineTop2, line lineBtm2, label lbl, string tag, color css, color breakCss) =>
    if id.breaker
        // pre-break segment (original OB span) - optional
        if bbShowPreBreakInput
            boxA.set_lefttop(id.loc, id.top)
            boxA.set_rightbottom(id.break_loc, id.btm)
            boxA.set_border_color(css.bbNoTransp())
            boxA.set_bgcolor(css)
            boxA.set_extend(extend.none)

            lineTop1.set_xy1(id.loc, id.top)
            lineTop1.set_xy2(id.break_loc, id.top)
            lineTop1.set_color(css.bbNoTransp())
            lineTop1.set_style(line.style_solid)
            lineTop1.set_extend(extend.none)

            lineBtm1.set_xy1(id.loc, id.btm)
            lineBtm1.set_xy2(id.break_loc, id.btm)
            lineBtm1.set_color(css.bbNoTransp())
            lineBtm1.set_style(line.style_solid)
            lineBtm1.set_extend(extend.none)
        else
            boxA.set_border_color(color(na))
            boxA.set_bgcolor(color(na))
            lineTop1.set_color(color(na))
            lineBtm1.set_color(color(na))

        // breaker zone (from break bar, extended right)
        boxB.set_lefttop(id.break_loc, id.top)
        boxB.set_rightbottom(time + 1, id.btm)
        boxB.set_border_color(breakCss.bbNoTransp())
        boxB.set_bgcolor(breakCss)
        boxB.set_extend(extend.right)

        lineTop2.set_xy1(id.break_loc, id.top)
        lineTop2.set_xy2(time + 1, id.top)
        lineTop2.set_color(breakCss.bbNoTransp())
        lineTop2.set_style(line.style_dashed)
        lineTop2.set_extend(extend.right)

        lineBtm2.set_xy1(id.break_loc, id.btm)
        lineBtm2.set_xy2(time + 1, id.btm)
        lineBtm2.set_color(breakCss.bbNoTransp())
        lineBtm2.set_style(line.style_dashed)
        lineBtm2.set_extend(extend.right)

        // breaker label (sits at the current candle, in the middle of the breaker zone)
        lbl.set_point(chart.point.new(na, last_bar_index, 0.5 * (id.top + id.btm)))
        lbl.set_text(bbShowTagInput ? tag : '')
        lbl.set_textcolor(breakCss.bbNoTransp())
        lbl.set_size(bbLabelSizeInput)
    else
        boxA.set_lefttop(id.loc, id.top)
        boxA.set_rightbottom(time, id.btm)
        boxA.set_border_color(color(na))
        boxA.set_bgcolor(css)
        boxA.set_extend(extend.right)

        // not yet broken - hide the "post-break" box and its two lines
        boxB.set_border_color(color(na))
        boxB.set_bgcolor(color(na))

        lineTop1.set_xy1(id.loc, id.top)
        lineTop1.set_xy2(time, id.top)
        lineTop1.set_color(css.bbNoTransp())
        lineTop1.set_style(line.style_solid)
        lineTop1.set_extend(extend.right)

        lineBtm1.set_xy1(id.loc, id.btm)
        lineBtm1.set_xy2(time, id.btm)
        lineBtm1.set_color(css.bbNoTransp())
        lineBtm1.set_style(line.style_solid)
        lineBtm1.set_extend(extend.right)

        lineTop2.set_color(color(na))
        lineBtm2.set_color(color(na))
        lbl.set_text('')

// Hides a pooled slot that currently has no order block assigned to it
bbHideSlot(box boxA, box boxB, line lineTop1, line lineBtm1, line lineTop2, line lineBtm2, label lbl) =>
    boxA.set_border_color(color(na))
    boxA.set_bgcolor(color(na))
    boxB.set_border_color(color(na))
    boxB.set_bgcolor(color(na))
    lineTop1.set_color(color(na))
    lineBtm1.set_color(color(na))
    lineTop2.set_color(color(na))
    lineBtm2.set_color(color(na))
    lbl.set_text('')

bbN   = bar_index
bbMax = bbUseBodyInput ? math.max(close, open) : high
bbMin = bbUseBodyInput ? math.min(close, open) : low

bbEffectiveLength = bbLengthSourceInput == 'Swing Structure' ? bbSwingLengthInput : bbLengthSourceInput == 'Internal Structure' ? bbInternalLengthInput : bbLengthInput

[bbTop, bbBtm] = bbSwings(bbEffectiveLength)

// Bullish OB
bbBullConf = 0

if close > bbTop.y and not bbTop.crossed
    bbTop.crossed := true

    minima = bbMax[1]
    maxima = bbMin[1]
    loc    = time[1]

    for i = 1 to (bbN - bbTop.x) - 1
        minima := math.min(bbMin[i], minima)
        maxima := minima == bbMin[i] ? bbMax[i] : maxima
        loc    := minima == bbMin[i] ? time[i] : loc
    bbBullishObs.unshift(bbOb.new(maxima, minima, loc))

if bbBullishObs.size() > 0
    for i = bbBullishObs.size() - 1 to 0
        element = bbBullishObs.get(i)

        if not element.breaker
            if math.min(close, open) < element.btm
                element.breaker   := true
                element.break_loc := time
        else
            if close > element.top
                bbBullishObs.remove(i)
            else if i < bbShowBullInput and bbTop.y < element.top and bbTop.y > element.btm
                bbBullConf := 1

if bbBullConf > bbBullConf[1]
    currentAlerts.bullishBreakerBlock := true
    if bbShowLabelsInput
        label.new(bbTop.x, bbTop.y, '▼', color = color(na), textcolor = bbBearCssInput.bbNoTransp(), style = label.style_label_down, size = size.tiny)

// Bearish OB
bbBearConf = 0

if close < bbBtm.y and not bbBtm.crossed
    bbBtm.crossed := true
    minima = bbMin[1]
    maxima = bbMax[1]
    loc    = time[1]

    for i = 1 to (bbN - bbBtm.x) - 1
        maxima := math.max(bbMax[i], maxima)
        minima := maxima == bbMax[i] ? bbMin[i] : minima
        loc    := maxima == bbMax[i] ? time[i] : loc

    bbBearishObs.unshift(bbOb.new(maxima, minima, loc))
if bbBearishObs.size() > 0
    for i = bbBearishObs.size() - 1 to 0
        element = bbBearishObs.get(i)

        if not element.breaker
            if math.max(close, open) > element.top
                element.breaker   := true
                element.break_loc := time
        else
            if close < element.btm
                bbBearishObs.remove(i)
            else if i < bbShowBearInput and bbBtm.y > element.btm and bbBtm.y < element.top
                bbBearConf := 1

if bbBearConf > bbBearConf[1]
    currentAlerts.bearishBreakerBlock := true
    if bbShowLabelsInput
        label.new(bbBtm.x, bbBtm.y, '▲', color = color(na), textcolor = bbBullCssInput.bbNoTransp(), style = label.style_label_up, size = size.tiny)

// Draw - breaker blocks only (unbroken OBs are skipped)
if barstate.islast and bbShowInput
    if bbShowBullInput > 0
        int bullSlot = 0
        if showBreakerBullishInput and bbBullishObs.size() > 0
            for i = 0 to bbBullishObs.size() - 1
                bbOb obj = bbBullishObs.get(i)
                if obj.breaker and bullSlot < bbShowBullInput
                    obj.bbApply(bbBullBoxA.get(bullSlot), bbBullBoxB.get(bullSlot), bbBullLineTop1.get(bullSlot), bbBullLineBtm1.get(bullSlot), bbBullLineTop2.get(bullSlot), bbBullLineBtm2.get(bullSlot), bbBullLabels.get(bullSlot), 'Bull BB', bbBullCssInput, bbBullBreakCssInput)
                    bullSlot += 1
        if bullSlot < bbShowBullInput
            for s = bullSlot to bbShowBullInput - 1
                bbHideSlot(bbBullBoxA.get(s), bbBullBoxB.get(s), bbBullLineTop1.get(s), bbBullLineBtm1.get(s), bbBullLineTop2.get(s), bbBullLineBtm2.get(s), bbBullLabels.get(s))

    if bbShowBearInput > 0
        int bearSlot = 0
        if showBreakerBearishInput and bbBearishObs.size() > 0
            for i = 0 to bbBearishObs.size() - 1
                bbOb obj = bbBearishObs.get(i)
                if obj.breaker and bearSlot < bbShowBearInput
                    obj.bbApply(bbBearBoxA.get(bearSlot), bbBearBoxB.get(bearSlot), bbBearLineTop1.get(bearSlot), bbBearLineBtm1.get(bearSlot), bbBearLineTop2.get(bearSlot), bbBearLineBtm2.get(bearSlot), bbBearLabels.get(bearSlot), 'Bear BB', bbBearCssInput, bbBearBreakCssInput)
                    bearSlot += 1
        if bearSlot < bbShowBearInput
            for s = bearSlot to bbShowBearInput - 1
                bbHideSlot(bbBearBoxA.get(s), bbBearBoxB.get(s), bbBearLineTop1.get(s), bbBearLineBtm1.get(s), bbBearLineTop2.get(s), bbBearLineBtm2.get(s), bbBearLabels.get(s))
//---------------------------------------------------------------------------------------------------------------------}
