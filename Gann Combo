//=====================================================================================================================
// 8. GANN BOX ENGINE
//=====================================================================================================================
// Visible Window / Manual Range modes: tracks the highest high / lowest low of the bars inside the window.
// Resets when a new window starts.
updateBoxExtremes(GannBoxState s, bool inView, bool windowStart) =>
    if windowStart
        s.hi := high
        s.lo := low
        s.hiBar := bar_index
        s.loBar := bar_index
    else if inView
        if high >= s.hi
            s.hi := high
            s.hiBar := bar_index
        if low <= s.lo
            s.lo := low
            s.loBar := bar_index

// Last Pivots mode: the box uses the most recent confirmed pivot high and pivot low.
// A pivot is confirmed 'len' bars after it forms, so its bar is bar_index - len.
updateBoxPivots(GannBoxState s, float ph, float pl, int len) =>
    if not na(ph)
        s.hi := ph
        s.hiBar := bar_index - len
    if not na(pl)
        s.lo := pl
        s.loBar := bar_index - len

// Fills the 7 x (time levels) / 7 y (price levels) grid points. Everything is na when the box is not valid.
// xs[i] = x position of time level i, ys[i] = price of price level i. s.bx0 / s.bx1 are the left / right box edges.
updateBoxGeometry(GannBoxState s, int[] xs, float[] ys, float[] pv, float[] tv) =>
    s.valid := not na(s.hiBar) and not na(s.loBar) and s.hiBar != s.loBar and s.hi > s.lo
    if s.valid
        s.rising := s.loBar < s.hiBar
        int x0 = math.min(s.hiBar, s.loBar)
        int endBar = math.max(s.hiBar, s.loBar)
        int x6 = extendInput ? math.min(bar_index + FUTURE_BARS, endBar + (endBar - x0)) : endBar
        float y0 = s.rising ? s.lo : s.hi
        float y6 = s.rising ? s.hi : s.lo
        s.bx0 := x0
        s.bx1 := x6
        for i = 0 to 6
            xs.set(i, clampX(math.round(x0 + (x6 - x0) * tv.get(i))))
            ys.set(i, y0 + (y6 - y0) * pv.get(i))
    else
        s.bx0 := na
        s.bx1 := na
        array.fill(xs, int(na))
        array.fill(ys, float(na))

// Background bands between consecutive enabled levels (price = horizontal bands, time = vertical bands).
renderBackground(bool enabled, box[] store, GannBoxState s, int[] xs, float[] ys) =>
    clearBoxes(store)
    if enabled
        if priceBgOn
            int prevP = -1
            for i = 0 to 6
                if priceOn.get(i)
                    if prevP >= 0
                        float yA = ys.get(prevP)
                        float yB = ys.get(i)
                        store.push(box.new(s.bx0, math.max(yA, yB), s.bx1, math.min(yA, yB), border_color = na, bgcolor = bandColor(priceCol.get(i), priceBgTransp, s.rising)))
                    prevP := i
        if timeBgOn
            int prevT = -1
            for i = 0 to 6
                if timeOn.get(i)
                    if prevT >= 0
                        store.push(box.new(xs.get(prevT), s.hi, xs.get(i), s.lo, border_color = na, bgcolor = bandColor(timeCol.get(i), timeBgTransp, s.rising)))
                    prevT := i

// Level lines: horizontal for price levels, vertical for time levels.
renderGrid(bool enabled, line[] store, GannBoxState s, int[] xs, float[] ys) =>
    clearLines(store)
    if enabled
        for i = 0 to 6
            if priceOn.get(i)
                store.push(line.new(s.bx0, ys.get(i), s.bx1, ys.get(i), color = priceCol.get(i), width = 1))
            if timeOn.get(i)
                store.push(line.new(xs.get(i), s.lo, xs.get(i), s.hi, color = timeCol.get(i), width = 1))

// Left / right labels for price levels, top / bottom labels for time levels.
renderBoxLabels(bool enabled, label[] store, GannBoxState s, int[] xs, float[] ys) =>
    clearLabels(store)
    if enabled
        for i = 0 to 6
            if priceOn.get(i)
                string pTxt = lvlText(priceVal.get(i))
                if showLeftLbl
                    store.push(label.new(s.bx0, ys.get(i), text = pTxt, textcolor = priceCol.get(i), color = color.new(color.white, 100), style = label.style_label_right))
                if showRightLbl
                    store.push(label.new(s.bx1, ys.get(i), text = pTxt, textcolor = priceCol.get(i), color = color.new(color.white, 100), style = label.style_label_left))
            if timeOn.get(i)
                string tTxt = lvlText(timeVal.get(i))
                if showTopLbl
                    store.push(label.new(xs.get(i), s.hi, text = tTxt, textcolor = timeCol.get(i), color = color.new(color.white, 100), style = label.style_label_down))
                if showBottomLbl
                    store.push(label.new(xs.get(i), s.lo, text = tTxt, textcolor = timeCol.get(i), color = color.new(color.white, 100), style = label.style_label_up))

// Gann fan: every line starts at the box start corner. 1/1 is the box diagonal, other lines are that slope x ratio.
// Lines with ratio <= 1 end on the right edge of the box, steeper lines end on the top / bottom edge.
renderFan(bool enabled, line[] lineStore, label[] labelStore, polyline[] fillStore, GannBoxState s) =>
    clearLines(lineStore)
    clearLabels(labelStore)
    clearPolylines(fillStore)
    if enabled
        float yS = s.rising ? s.lo : s.hi
        float yE = s.rising ? s.hi : s.lo
        int prevX = na
        float prevY = na
        for i = 0 to 8
            if fanOn.get(i)
                float r = fanRatio.get(i)
                int ex = r <= 1.0 ? s.bx1 : math.round(s.bx0 + (s.bx1 - s.bx0) / r)
                float ey = r <= 1.0 ? yS + (yE - yS) * r : yE
                color c = fanColor(fanCol.get(i), s.rising)
                lineStore.push(line.new(s.bx0, yS, ex, ey, color = c))
                if fanBgOn and not na(prevX)
                    array<chart.point> pts = array.new<chart.point>()
                    pts.push(chart.point.from_index(s.bx0, yS))
                    pts.push(chart.point.from_index(prevX, prevY))
                    pts.push(chart.point.from_index(ex, ey))
                    fillStore.push(polyline.new(pts, false, true, line_color = na, fill_color = color.new(c, fanBgTransp)))
                if fanLblOn
                    labelStore.push(label.new(ex, ey, text = fanText.get(i), textcolor = c, color = color.new(color.white, 100), style = r <= 1.0 ? label.style_label_left : (s.rising ? label.style_label_down : label.style_label_up)))
                prevX := ex
                prevY := ey

// Gann curves: each enabled curve is a quarter-ellipse from the box start corner. Its time / price reach is
// the curve's own value (0.25 ... 1.0) of the box width / height. A label with the value sits at the curve midpoint.
// Background fills the band between consecutive enabled curves (the first one fills back to the start corner).
renderCurves(bool enabled, polyline[] store, polyline[] fillStore, label[] lblStore, GannBoxState s) =>
    clearPolylines(store)
    clearPolylines(fillStore)
    clearLabels(lblStore)
    if enabled
        float yS = s.rising ? s.lo : s.hi
        float yE = s.rising ? s.hi : s.lo
        array<chart.point> prevPts = na
        for i = 0 to 5
            if curveOn.get(i)
                float v = curveVal.get(i)
                color c = curveColor(ccol.get(i), s.rising)
                int xv = clampX(math.round(s.bx0 + (s.bx1 - s.bx0) * v))
                float yv = yS + (yE - yS) * v
                array<chart.point> pts = array.new<chart.point>()
                for j = 0 to 90
                    float rad = math.toradians(j)
                    int px = math.round(s.bx0 - (s.bx0 - xv) * math.sin(rad))
                    float py = yS + math.cos(rad) * (yv - yS)
                    pts.push(chart.point.from_index(px, py))
                if curveBgOn
                    array<chart.point> poly = array.copy(pts)
                    if na(prevPts)
                        poly.push(chart.point.from_index(s.bx0, yS))
                    else
                        for k = array.size(prevPts) - 1 to 0
                            poly.push(prevPts.get(k))
                    fillStore.push(polyline.new(poly, false, true, line_color = na, fill_color = color.new(c, curveBgTransp)))
                store.push(polyline.new(pts, false, false, line_color = c))
                if showCurveLbl
                    float radM = math.toradians(45)
                    int mx = math.round(s.bx0 - (s.bx0 - xv) * math.sin(radM))
                    float my = yS + math.cos(radM) * (yv - yS)
                    lblStore.push(label.new(mx, my, text = lvlText(v), textcolor = c, color = color.new(color.white, 100), style = label.style_label_center))
                prevPts := pts

renderAngles(bool enabled, line[] store, GannBoxState s, int[] xs, float[] ys) =>
    clearLines(store)
    if enabled
        int x0 = s.bx0
        int x6 = s.bx1
        float y0 = s.rising ? s.lo : s.hi
        float y6 = s.rising ? s.hi : s.lo
        for i = 0 to 6
            int xx = xs.get(i)
            float yy = ys.get(i)
            if i > 0
                store.push(line.new(x0, y0, xx, y6, color = acol))
                store.push(line.new(x0, y0, x6, yy, color = acol))
                store.push(line.new(x0, y6, xx, y0, color = acol))
                store.push(line.new(x0, y6, x6, yy, color = acol))
            if i < 6
                store.push(line.new(x6, y6, xx, y0, color = acol))
                store.push(line.new(x6, y6, x0, yy, color = acol))
                store.push(line.new(x6, y0, xx, y6, color = acol))
                store.push(line.new(x6, y0, x0, yy, color = acol))

//=====================================================================================================================
// 9. SQUARE OF 9 ENGINE
//=====================================================================================================================
// Anchor selection (pivot values are computed at global scope, every bar).
updateAnchor(AnchorState a, float ph, float pl) =>
    a.changed := false
    if anchorTypeInput == "Manual"
        if na(a.manualBar) and time >= manualTimeInput
            a.manualBar := bar_index
            if manualPriceInput > 0.0
                a.price := manualPriceInput
                a.bar := bar_index
                a.isLow := manualIsLowInput
                a.changed := true
    else
        bool useHigh = anchorTypeInput == "Auto pivot" or anchorTypeInput == "Pivot High"
        bool useLow = anchorTypeInput == "Auto pivot" or anchorTypeInput == "Pivot Low"
        if useHigh and not na(ph)
            a.price := ph
            a.bar := bar_index - pivotLookbackInput
            a.isLow := false
            a.changed := true
        if useLow and not na(pl)
            a.price := pl
            a.bar := bar_index - pivotLookbackInput
            a.isLow := true
            a.changed := true

// Price = (sqrt(Anchor) + Degree / 180) ^ 2
buildLevels(Level[] arr, float anchorPrice) =>
    array.clear(arr)
    float root = math.sqrt(anchorPrice)
    int steps = int(math.round(360.0 / degreeStepInput))
    for cy = 0 to cyclesInput - 1
        for k = 1 to steps
            float deg = cy * 360.0 + k * degreeStepInput
            bool isCard = deg % 90.0 == 0.0
            bool isKeyLvl = deg % 180.0 == 0.0
            if directionInput != "Down"
                arr.push(Level.new(math.pow(root + deg / 180.0, 2), deg, isCard, isKeyLvl))
            if directionInput != "Up"
                float r = root - deg / 180.0
                if r > 0.0
                    arr.push(Level.new(math.pow(r, 2), -deg, isCard, isKeyLvl))

isTypeShown(Level lvl) => (lvl.isCardinal and showCardinalInput) or (not lvl.isCardinal and showOrdinalInput)

isVisible(Level lvl, float refPrice) =>
    bool distOk = maxDistInput <= 0.0 or (refPrice > 0.0 and math.abs(lvl.price - refPrice) / refPrice * 100.0 <= maxDistInput)
    isTypeShown(lvl) and distOk

levelColor(Level lvl) => lvl.isKey ? keyColorInput : lvl.isCardinal ? cardinalColorInput : ordinalColorInput

// Level label text: "degree / price" on one line when the toggle is on, otherwise price below the degree.
levelLabelText(Level lvl) =>
    string sep = labelOneLineInput ? " / " : "\n"
    degText(lvl.degree) + sep + str.tostring(lvl.price, format.mintick)

// Returns a text list of every visible level crossed by the last close (empty string = none).
checkLevelCross(Level[] lv, float prevClose) =>
    string hit = ""
    for l in lv
        bool crossed = (prevClose < l.price and close >= l.price) or (prevClose > l.price and close <= l.price)
        if crossed and isVisible(l, close)
            hit += degText(l.degree) + " @ " + str.tostring(l.price, format.mintick) + "  "
    hit

renderSquare(bool enabled, line[] lineStore, label[] labelStore, Level[] lv, AnchorState a) =>
    clearLines(lineStore)
    clearLabels(labelStore)
    if enabled
        int xEnd = bar_index + 10
        int xAnchor = math.max(a.bar, bar_index - MAX_PAST_BARS)
        if showAnchorLineInput
            lineStore.push(line.new(xAnchor, a.price, xEnd, a.price, color = anchorColorInput, style = line.style_dotted, width = 1, extend = extendRightInput ? extend.right : extend.none))
        if showAnchorLabelInput
            labelStore.push(label.new(xAnchor, a.price, "Anchor", style = a.isLow ? label.style_label_up : label.style_label_down, color = anchorColorInput, textcolor = color.black, size = size.tiny))
        for lvl in lv
            if isVisible(lvl, close)
                color lvlColor = levelColor(lvl)
                int lvlWidth = lvl.isCardinal ? (lvl.isKey ? cardWidthInput + 1 : cardWidthInput) : ordWidthInput
                lineStore.push(line.new(xAnchor, lvl.price, xEnd, lvl.price, color = lvlColor, style = lvl.isCardinal ? parsedCardStyle : parsedOrdStyle, width = lvlWidth, extend = extendRightInput ? extend.right : extend.none))
                if levelLabelsInput
                    labelStore.push(label.new(xEnd, lvl.price, levelLabelText(lvl), color = #00000000, style = label.style_label_left, textcolor = lvlColor, size = size.small))

renderWarning(label[] store, AnchorState a) =>
    clearLabels(store)
    string warnText = ""
    if masterOn and showSquare and anchorTypeInput == "Manual"
        if manualPriceInput <= 0.0
            warnText := "Gann: set Manual Anchor Price > 0"
        else if na(a.manualBar)
            warnText := "Gann: Manual Anchor Time is after the last bar"
    if warnText != ""
        store.push(label.new(bar_index, high, warnText, style = label.style_label_down, color = color.new(color.orange, 0), textcolor = color.black, size = size.small))

//=====================================================================================================================
// 9B. GANN TIME CYCLES ENGINE
//=====================================================================================================================
// A full-height vertical line at originBar + each enabled cycle length.
renderTimeCycles(bool enabled, line[] lineStore, label[] labelStore, int originBar) =>
    clearLines(lineStore)
    clearLabels(labelStore)
    if enabled
        for i = 0 to array.size(cycVal) - 1
            if cycOn.get(i)
                int n = cycVal.get(i)
                int xc = originBar + n
                bool inWindow   = xc <= bar_index + FUTURE_BARS and xc >= bar_index - MAX_PAST_BARS
                bool hiddenPast = cycHidePastInput and xc < bar_index
                if inWindow and not hiddenPast
                    color cc = cycCol.get(i)
                    lineStore.push(line.new(xc, close, xc, close + syminfo.mintick, color = cc, style = parsedCycleStyle, width = cycWidthInput, extend = extend.both))
                    if cycLabelsInput
                        labelStore.push(label.new(xc, close, str.tostring(n), style = label.style_label_down, color = color.new(color.white, 100), textcolor = color.new(cc, 0), size = size.small))

renderCycleWarning(label[] store, bool show, string txt) =>
    clearLabels(store)
    if show
        store.push(label.new(bar_index, low, txt, style = label.style_label_up, color = color.new(color.orange, 0), textcolor = color.black, size = size.small))

//=====================================================================================================================
// 10. MAIN - PER-BAR CALCULATION
//=====================================================================================================================
// Gann Box. Box Anchor decides which bars define the box:
//   Visible Window = bars on screen, Manual Range = bars between start and end, Last Pivots = last confirmed pivots.
float boxPivHigh = ta.pivothigh(high, boxPivotLenInput, boxPivotLenInput)
float boxPivLow = ta.pivotlow(low, boxPivotLenInput, boxPivotLenInput)
bool inRange = time >= boxRangeStartInput and time <= boxRangeEndInput
bool inBox = boxAnchorInput == BA_MANUAL ? inRange : barIsVisible()
bool boxStart = inBox and not inBox[1]
if boxAnchorInput == BA_PIVOTS
    updateBoxPivots(gb, boxPivHigh, boxPivLow, boxPivotLenInput)
else
    updateBoxExtremes(gb, inBox, boxStart)
updateBoxGeometry(gb, gx, gy, priceVal, timeVal)

// Square of 9 anchor and levels
float pHigh = ta.pivothigh(high, pivotLookbackInput, pivotLookbackInput)
float pLow = ta.pivotlow(low, pivotLookbackInput, pivotLookbackInput)
float prevClose = close[1]
updateAnchor(anc, pHigh, pLow)
bool anchorReady = not na(anc.price) and anc.price > 0.0
if anchorReady and (anc.changed or barstate.islast)
    buildLevels(levels, anc.price)

// Gann Time Cycles origin (bar index the cycle lengths are counted from).
//   Anchor         = pivot anchor (or the manual anchor bar, which needs no price)
//   Gann Box Start = left edge of the Gann Box
int ancOrigin = anchorTypeInput == "Manual" ? anc.manualBar : anc.bar
int boxOrigin = gb.valid ? gb.bx0 : na
int cycleOrigin = cycleOriginInput == "Gann Box Start" ? boxOrigin : ancOrigin

bool sqReady = showSquare and anchorReady and array.size(levels) > 0

//=====================================================================================================================
// 11. ALERTS
//=====================================================================================================================
// ta.* calls stay at global scope and run on every bar (consistent history, no short-circuit skipping).
cu0 = ta.crossunder(low, gy.get(0))
co0 = ta.crossover(high, gy.get(0))
cu1 = ta.crossunder(low, gy.get(1))
co1 = ta.crossover(high, gy.get(1))
cu2 = ta.crossunder(low, gy.get(2))
co2 = ta.crossover(high, gy.get(2))
cu3 = ta.crossunder(low, gy.get(3))
co3 = ta.crossover(high, gy.get(3))
cu4 = ta.crossunder(low, gy.get(4))
co4 = ta.crossover(high, gy.get(4))
cu5 = ta.crossunder(low, gy.get(5))
co5 = ta.crossover(high, gy.get(5))

alertcondition(masterOn and (cu0 or co0), "Gann Box Breakout", "Price breaks out from Gann Box")
alertcondition(masterOn and (cu1 or co1), "Gann Box Breakout Level 1", "Price breaks Level 1")
alertcondition(masterOn and (cu2 or co2), "Gann Box Breakout Level 2", "Price breaks Level 2")
alertcondition(masterOn and (cu3 or co3), "Gann Box Breakout Level 3", "Price breaks Level 3")
alertcondition(masterOn and (cu4 or co4), "Gann Box Breakout Level 4", "Price breaks Level 4")
alertcondition(masterOn and (cu5 or co5), "Gann Box Breakout Level 5", "Price breaks Level 5")

// Square of 9 level-cross alert: realtime only, skipped on the bar where the anchor (and so every level) changed.
if masterOn and showSquare and alertInput and barstate.isrealtime and anchorReady and not anc.changed and bar_index > 0 and array.size(levels) > 0
    string hit = checkLevelCross(levels, prevClose)
    if hit != ""
        alert(syminfo.ticker + " crossed Gann level: " + hit, alert.freq_once_per_bar_close)

//=====================================================================================================================
// 12. MAIN - RENDERING (last bar only)
//=====================================================================================================================
if barstate.islast
    renderBackground(masterOn and gb.valid and showBox, boxStore, gb, gx, gy)
    renderGrid(masterOn and gb.valid and showBox, gridStore, gb, gx, gy)
    renderBoxLabels(masterOn and gb.valid and showBox, boxLabelStore, gb, gx, gy)
    renderFan(masterOn and gb.valid and showFan, fanStore, fanLabelStore, fanFillStore, gb)
    renderCurves(masterOn and gb.valid and showCurve, curveStore, curveFillStore, curveLabelStore, gb)
    renderAngles(masterOn and gb.valid and showAngles, angleStore, gb, gx, gy)
    renderSquare(masterOn and sqReady, sqLineStore, sqLabelStore, levels, anc)
    renderWarning(warnStore, anc)

    // Gann Time Cycles (independent of the Square of 9 master switch)
    bool cycOriginOk = not na(cycleOrigin)
    renderTimeCycles(masterOn and showTimeInput and cycOriginOk, cycLineStore, cycLabelStore, cycleOrigin)

    string cycWarnText = ""
    if showTimeInput and not cycOriginOk
        if cycleOriginInput == "Gann Box Start"
            cycWarnText := "Gann Cycles: no valid Gann Box start (check Box Anchor settings)"
        else if anchorTypeInput == "Manual"
            cycWarnText := "Gann Cycles: Manual Anchor Time is after the last bar"
        else
            cycWarnText := "Gann Cycles: no pivot found yet - try a smaller Pivot Lookback"
    renderCycleWarning(cycWarnStore, masterOn and cycWarnText != "", cycWarnText)

//=====================================================================================================================
// 13. DASHBOARD (moved to the end of the script)
//=====================================================================================================================
setCell(table tbl, int col, int row, string txt, color tc = #FFFFFF, string align = text.align_right, color bg = na) =>
    table.cell(tbl, col, row, txt, text_color = tc, text_size = parsedDashboardSize, text_halign = align, bgcolor = bg)

setDivider(table tbl, int row) =>
    table.merge_cells(tbl, 0, row, 2, row)
    table.cell(tbl, 0, row, "", height = 0.3, bgcolor = BORDERS)

renderDashboard(bool enabled, table[] store, AnchorState a, Level[] lv, int cycOrigin) =>
    for tb in store
        table.delete(tb)
    array.clear(store)
    if enabled
        table tbl = table.new(parsedDashboardPosition, 3, 13, bgcolor = BACKGROUND, border_width = 0, frame_color = BORDERS, frame_width = 1, force_overlay = true)
        store.push(tbl)
        float curAngle = (math.sqrt(close) - math.sqrt(a.price)) * 180.0
        float wrapAngle = ((curAngle % 360.0) + 360.0) % 360.0
        bool cycReady = showTimeInput and not na(cycOrigin)
        int elapsed = cycReady ? bar_index - cycOrigin : 0
        int nextCycle = na
        if cycReady
            for i = 0 to array.size(cycVal) - 1
                if cycOn.get(i)
                    int n = cycVal.get(i)
                    if n > elapsed and (na(nextCycle) or n < nextCycle)
                        nextCycle := n
        float[] prices = array.new_float()
        for l in lv
            prices.push(l.price)
        int[] sortedIdx = array.sort_indices(prices, order.ascending)
        Level[] aboveLv = array.new<Level>()
        Level[] belowLv = array.new<Level>()
        int total = array.size(sortedIdx)
        for i = 0 to total - 1
            Level lv1 = lv.get(sortedIdx.get(i))
            if lv1.price > close and isVisible(lv1, close) and array.size(aboveLv) < 3
                aboveLv.push(lv1)
        for j = total - 1 to 0
            Level lv2 = lv.get(sortedIdx.get(j))
            if lv2.price < close and isVisible(lv2, close) and array.size(belowLv) < 3
                belowLv.push(lv2)
        table.merge_cells(tbl, 0, 0, 2, 0)
        setCell(tbl, 0, 0, "Vibration Levels", DATA, text.align_center)
        setDivider(tbl, 1)
        setCell(tbl, 0, 2, "Anchor", HEADERS, text.align_left)
        setCell(tbl, 1, 2, str.tostring(a.price, format.mintick), DATA)
        setCell(tbl, 2, 2, anchorTypeInput == "Manual" ? "Manual" : (a.isLow ? "Low" : "High"), a.isLow ? BULL_COLOR : BEAR_COLOR)
        setCell(tbl, 0, 3, "Price Angle", HEADERS, text.align_left)
        setCell(tbl, 1, 3, degText(math.round(curAngle * 10) / 10.0), DATA)
        setCell(tbl, 2, 3, str.tostring(wrapAngle, "#.#") + " deg / " + str.tostring(curAngle / 360.0, "#.##") + "x", HEADERS)
        setCell(tbl, 0, 4, "Next Time Cycle", HEADERS, text.align_left)
        setCell(tbl, 1, 4, na(nextCycle) ? "-" : str.tostring(nextCycle) + " bars", DATA)
        setCell(tbl, 2, 4, na(nextCycle) ? (cycReady ? "done" : "off") : "in " + str.tostring(nextCycle - elapsed), HEADERS)
        setDivider(tbl, 5)
        for i = 0 to array.size(aboveLv) - 1
            Level up = aboveLv.get(i)
            int rowUp = 8 - i
            setCell(tbl, 0, rowUp, degText(up.degree), levelColor(up), text.align_left)
            setCell(tbl, 1, rowUp, str.tostring(up.price, format.mintick), DATA, text.align_center)
            setCell(tbl, 2, rowUp, "+" + str.tostring((up.price - close) / close * 100.0, "#.##") + "%", BEAR_COLOR)
        table.merge_cells(tbl, 0, 9, 2, 9)
        setCell(tbl, 0, 9, "Price  " + str.tostring(close, format.mintick), DATA, text.align_center, color.new(color.gray, 70))
        for i = 0 to array.size(belowLv) - 1
            Level dn = belowLv.get(i)
            int rowDn = 10 + i
            setCell(tbl, 0, rowDn, degText(dn.degree), levelColor(dn), text.align_left)
            setCell(tbl, 1, rowDn, str.tostring(dn.price, format.mintick), DATA, text.align_center)
            setCell(tbl, 2, rowDn, str.tostring((dn.price - close) / close * 100.0, "#.##") + "%", BULL_COLOR)

if barstate.islast
    renderDashboard(masterOn and sqReady and dashboardInput, dashStore, anc, levels, cycleOrigin)
