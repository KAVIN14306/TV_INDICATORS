// ──────────────────────────────────────────────────────────────────────────────
// Core helpers
// ──────────────────────────────────────────────────────────────────────────────
// PATCH 1: CPR data is only requested when CPR is the active indicator
t_resDaily = cprOn ? 'D' : timeframe.period
t_resWeekly = cprOn ? 'W' : timeframe.period
t_resMonthly = cprOn ? 'M' : timeframe.period

get_pivot_resolution() =>
    string res_ = 'D'
    if pivot_mode == 'Manual'
        if manual_primary == 'Daily'
            res_ := 'D'
        else if manual_primary == 'Weekly'
            res_ := 'W'
        else if manual_primary == 'Monthly'
            res_ := 'M'
        else
            res_ := manual_daily ? 'D' : manual_weekly ? 'W' : manual_monthly ? 'M' : 'D'
    else
        if timeframe.isintraday
            res_ := timeframe.multiplier <= 15 ? 'D' : timeframe.multiplier <= 75 ? 'W' : 'M'
        else if timeframe.isdaily
            res_ := 'M'
        else if timeframe.isweekly
            res_ := '6M'
        else
            res_ := '12M'
    res_

resolution = get_pivot_resolution()

t_getBounds(h, l, c) =>
    t_pivot = (h + l + c) / 3.0
    t_bc = (h + l) / 2.0
    t_tc = 2.0 * t_pivot - t_bc
    [t_bc, t_tc, t_pivot]

calc_rs_levels(piv, h, l, c) =>
    rng = h - l
    float _r1 = na
    float _s1 = na
    float _r2 = na
    float _s2 = na
    float _r3 = na
    float _s3 = na
    float _r4 = na
    float _s4 = na
    float _r5 = na
    float _s5 = na
    if kind == TRADITIONAL
        _r1 := piv * 2 - l
        _s1 := piv * 2 - h
        _r2 := piv + rng
        _s2 := piv - rng
        _r3 := _r1 + rng
        _s3 := _s1 - rng
        _r4 := _r3 + _r2 - _r1
        _s4 := _s3 + _s2 - _s1
        _r5 := _r4 + _r3 - _r2
        _s5 := _s4 + _s3 - _s2
    else if kind == FIBONACCI
        _r1 := piv + 0.382 * rng
        _s1 := piv - 0.382 * rng
        _r2 := piv + 0.618 * rng
        _s2 := piv - 0.618 * rng
        _r3 := piv + 1 * rng
        _s3 := piv - 1 * rng
    else if kind == CLASSIC
        _r1 := piv * 2 - l
        _s1 := piv * 2 - h
        _r2 := piv + 1 * rng
        _s2 := piv - 1 * rng
        _r3 := piv + 2 * rng
        _s3 := piv - 2 * rng
        _r4 := piv + 3 * rng
        _s4 := piv - 3 * rng
    else if kind == CAMARILLA
        _r1 := c + rng * 1.1 / 12.0
        _s1 := c - rng * 1.1 / 12.0
        _r2 := c + rng * 1.1 / 6.0
        _s2 := c - rng * 1.1 / 6.0
        _r3 := c + rng * 1.1 / 4.0
        _s3 := c - rng * 1.1 / 4.0
        _r4 := c + rng * 1.1 / 2.0
        _s4 := c - rng * 1.1 / 2.0
        _r5 := h / l * c
        _s5 := 2 * c - _r5
    [_r1, _s1, _r2, _s2, _r3, _s3, _r4, _s4, _r5, _s5]

// ──────────────────────────────────────────────────────────────────────────────
// Data requests (each period requested ONCE and reused)
// ──────────────────────────────────────────────────────────────────────────────
[d_t0, d_t1, d_t2, d_t3, d_t4, d_t5, d_t6, d_t7, d_t8, d_t9, d_t10] = request.security(syminfo.tickerid, t_resDaily, [time, time[1], time[2], time[3], time[4], time[5], time[6], time[7], time[8], time[9], time[10]], lookahead = barmerge.lookahead_on)
[w_t0, w_t1, w_t2, w_t3, w_t4, w_t5, w_t6, w_t7, w_t8, w_t9, w_t10] = request.security(syminfo.tickerid, t_resWeekly, [time, time[1], time[2], time[3], time[4], time[5], time[6], time[7], time[8], time[9], time[10]], lookahead = barmerge.lookahead_on)
