// ATR trailing stop (source = close); one function serves both the Buy and Sell sides
f_ut(int len, float key) =>
    float nl = key * ta.atr(len)
    float ts = 0.0
    ts := close > nz(ts[1], 0) and close[1] > nz(ts[1], 0) ? math.max(nz(ts[1]), close - nl) : close < nz(ts[1], 0) and close[1] < nz(ts[1], 0) ? math.min(nz(ts[1]), close + nl) : close > nz(ts[1], 0) ? close - nl : close + nl
    ts

ut_xATRTrailingStopBuy = f_ut(ut_buyATRPeriod, ut_buyKeyValue)
ut_xATRTrailingStopSell = f_ut(ut_sellATRPeriod, ut_sellKeyValue)
ut_buy = ta.crossover(close, ut_xATRTrailingStopBuy)
ut_sell = ta.crossunder(close, ut_xATRTrailingStopSell)

plotshape(on_ut and ut_show and ut_buy, title = 'UT Bot Buy', text = 'Buy', style = shape.labelup, location = location.belowbar, color = color.new(color.green, 0), textcolor = color.white, size = size.tiny, display = display.all - display.status_line)
plotshape(on_ut and ut_show and ut_sell, title = 'UT Bot Sell', text = 'Sell', style = shape.labeldown, location = location.abovebar, color = color.new(color.red, 0), textcolor = color.white, size = size.tiny, display = display.all - display.status_line)

