f_cpr(sym) =>
    [dh, dl, dc] = request.security(sym, "D", [high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)
    pp = (dh + dl + dc) / 3.0
    bc = (dh + dl) / 2.0
    tc = 2.0 * pp - bc
    [bc, tc]

f_loc(price, bc, tc) =>
    upper = math.max(bc, tc)
    lower = math.min(bc, tc)
    price > upper ? 1 : price < lower ? -1 : 0

// PATCH 2: pair symbols are only requested in Pairs mode
symA_eff = cprOn and t_biasMode == 'Pairs' ? pair_symA : syminfo.tickerid
symB_eff = cprOn and t_biasMode == 'Pairs' ? pair_symB : syminfo.tickerid
[bcA, tcA] = f_cpr(symA_eff)
[bcB, tcB] = f_cpr(symB_eff)
closeA = request.security(symA_eff, timeframe.period, close, lookahead = barmerge.lookahead_off)
closeB = request.security(symB_eff, timeframe.period, close, lookahead = barmerge.lookahead_off)
locA = f_loc(closeA, bcA, tcA)
locB = f_loc(closeB, bcB, tcB)

bool pairSame = pair_relation == 'Same Direction'
bool pairBull = pairSame ? (locA == 1 and locB == 1) : (locA == 1 and locB == -1)
bool pairBear = pairSame ? (locA == -1 and locB == -1) : (locA == -1 and locB == 1)

t_tradeBias_curr = t_locD == 'Above' ? 'Bulls' : t_locD == 'Below' ? 'Bears' : 'Patience'
