// ——— SMC feature toggles, gated by the SMC master switches ———
showTrendInput = smc_f_on and smc_struct_master and showTrendInputRaw
showInternalsInput = smc_f_on and smc_struct_master and showInternalsInputRaw
showStructureInput = smc_f_on and smc_struct_master and showStructureInputRaw
showSwingsInput = smc_f_on and smc_struct_master and showSwingsInputRaw
showHighLowSwingsInput = smc_f_on and smc_hl_master and showHighLowSwingsInputRaw
showInternalOrderBlocksInput = smc_f_on and smc_ob_master and showInternalOrderBlocksInputRaw
showSwingOrderBlocksInput = smc_f_on and smc_ob_master and showSwingOrderBlocksInputRaw
showEqualHighsLowsInput = smc_f_on and smc_eq_master and showEqualHighsLowsInputRaw
showFairValueGapsInput = smc_f_on and smc_fvg_master and showFairValueGapsInputRaw
showHTF1Input = smc_f_on and smc_htf_fvg_master and showHTF1InputRaw
showHTF2Input = smc_f_on and smc_htf_fvg_master and showHTF2InputRaw
showHTFOb1Input = smc_f_on and smc_htf_ob_master and showHTFOb1InputRaw
showHTFOb2Input = smc_f_on and smc_htf_ob_master and showHTFOb2InputRaw
showDailyLevelsInput = smc_f_on and smc_lvl_master and showDailyLevelsInputRaw
showWeeklyLevelsInput = smc_f_on and smc_lvl_master and showWeeklyLevelsInputRaw
showMonthlyLevelsInput = smc_f_on and smc_lvl_master and showMonthlyLevelsInputRaw
showPremiumDiscountZonesInput = smc_f_on and smc_zone_master and showPremiumDiscountZonesInputRaw
bbShowInput = smc_f_on and smc_bb_master and bbShowInputRaw

//---------------------------------------------------------------------------------------------------------------------
// SMC DATA STRUCTURES & VARIABLES
//---------------------------------------------------------------------------------------------------------------------
type alerts
    bool internalBullishBOS = false
    bool internalBearishBOS = false
    bool internalBullishCHoCH = false
    bool internalBearishCHoCH = false
    bool swingBullishBOS = false
    bool swingBearishBOS = false
    bool swingBullishCHoCH = false
    bool swingBearishCHoCH = false
    bool internalBullishOrderBlock = false
    bool internalBearishOrderBlock = false
    bool swingBullishOrderBlock = false
    bool swingBearishOrderBlock = false
    bool equalHighs = false
    bool equalLows = false
    bool bullishFairValueGap = false
    bool bearishFairValueGap = false
    bool htf1BullishFVG = false
    bool htf1BearishFVG = false
    bool htf2BullishFVG = false
    bool htf2BearishFVG = false
    bool htf1BullishOB = false
    bool htf1BearishOB = false
    bool htf2BullishOB = false
    bool htf2BearishOB = false
    bool bullishBreakerBlock = false
    bool bearishBreakerBlock = false

type trailingExtremes
    float top
    float bottom
    int barTime
    int barIndex
    int lastTopTime
    int lastBottomTime

type fairValueGap
    float top
    float bottom
    int bias
    box topBox
    box bottomBox
    int leftTime

type htfFairValueGap
    float top
    float bottom
    int bias
    box b_ox
    bool active
    label l_abel

type trend
    int bias

type equalDisplay
    line l_ine = na
    label l_abel = na

type pivot
    float currentLevel
    float lastLevel
    bool crossed
    int barTime = time
    int barIndex = bar_index

type orderBlock
    float barHigh
    float barLow
    int barTime
    int bias

var pivot swingHigh = pivot.new(na, na, false)
var pivot swingLow = pivot.new(na, na, false)
var pivot internalHigh = pivot.new(na, na, false)
var pivot internalLow = pivot.new(na, na, false)
var pivot equalHigh = pivot.new(na, na, false)
var pivot equalLow = pivot.new(na, na, false)
var trend swingTrend = trend.new(0)
var trend internalTrend = trend.new(0)
var equalDisplay equalHighDisplay = equalDisplay.new()
var equalDisplay equalLowDisplay = equalDisplay.new()
var array<fairValueGap> fairValueGaps = array.new<fairValueGap>()
var array<htfFairValueGap> htf1Gaps = array.new<htfFairValueGap>()
var array<htfFairValueGap> htf2Gaps = array.new<htfFairValueGap>()
var array<htfFairValueGap> htf1Obs = array.new<htfFairValueGap>()
var array<htfFairValueGap> htf2Obs = array.new<htfFairValueGap>()
var array<float> parsedHighs = array.new<float>()
var array<float> parsedLows = array.new<float>()
var array<float> highs = array.new<float>()
var array<float> lows = array.new<float>()
var array<int> times = array.new<int>()
var int trimOffset = 0
var trailingExtremes trailing = trailingExtremes.new()
var array<orderBlock> swingOrderBlocks = array.new<orderBlock>()
var array<orderBlock> internalOrderBlocks = array.new<orderBlock>()
var array<box> swingOrderBlocksBoxes = array.new<box>()
var array<box> internalOrderBlocksBoxes = array.new<box>()
var array<label> swingOrderBlocksLabels = array.new<label>()
var array<label> internalOrderBlocksLabels = array.new<label>()
var swingBullishColor = styleInput == MONOCHROME ? MONO_BULLISH : swingBullColorInput
var swingBearishColor = styleInput == MONOCHROME ? MONO_BEARISH : swingBearColorInput
var fairValueGapBullishColor = styleInput == MONOCHROME ? color.new(MONO_BULLISH, 70) : fairValueGapsBullColorInput
var fairValueGapBearishColor = styleInput == MONOCHROME ? color.new(MONO_BEARISH, 70) : fairValueGapsBearColorInput
var premiumZoneColor = styleInput == MONOCHROME ? MONO_BEARISH : premiumZoneColorInput
var discountZoneColor = styleInput == MONOCHROME ? MONO_BULLISH : discountZoneColorInput
varip int currentBarIndex = bar_index
varip int lastBarIndex = bar_index
alerts currentAlerts = alerts.new()
var initialTime = time

// Breaker Blocks - reusable drawing object pools
var array<box> bbBullBoxA = array.new<box>()
var array<box> bbBullBoxB = array.new<box>()
var array<line> bbBullLineTop1 = array.new<line>()
var array<line> bbBullLineBtm1 = array.new<line>()
var array<line> bbBullLineTop2 = array.new<line>()
var array<line> bbBullLineBtm2 = array.new<line>()
var array<label> bbBullLabels = array.new<label>()
var array<box> bbBearBoxA = array.new<box>()
var array<box> bbBearBoxB = array.new<box>()
var array<line> bbBearLineTop1 = array.new<line>()
var array<line> bbBearLineBtm1 = array.new<line>()
var array<line> bbBearLineTop2 = array.new<line>()
var array<line> bbBearLineBtm2 = array.new<line>()
var array<label> bbBearLabels = array.new<label>()

if barstate.isfirst
    if showSwingOrderBlocksInput
        for index = 1 to swingOrderBlocksSizeInput
            swingOrderBlocksBoxes.push(box.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right))
            swingOrderBlocksLabels.push(label.new(na, na, text = '', color = color(na), textcolor = color.white, style = label.style_label_center, size = obLabelSizeInput))
    if showInternalOrderBlocksInput
        for index = 1 to internalOrderBlocksSizeInput
            internalOrderBlocksBoxes.push(box.new(na, na, na, na, xloc = xloc.bar_time, extend = extend.right))
            internalOrderBlocksLabels.push(label.new(na, na, text = '', color = color(na), textcolor = color.white, style = label.style_label_center, size = obLabelSizeInput))
    if bbShowInput
        for index = 1 to bbShowBullInput
            bbBullBoxA.push(box.new(na, na, na, na, xloc = xloc.bar_time, border_color = color(na), bgcolor = color(na)))
            bbBullBoxB.push(box.new(na, na, na, na, xloc = xloc.bar_time, border_color = color(na), bgcolor = color(na)))
            bbBullLineTop1.push(line.new(na, na, na, na, xloc = xloc.bar_time, color = color(na)))
            bbBullLineBtm1.push(line.new(na, na, na, na, xloc = xloc.bar_time, color = color(na)))
            bbBullLineTop2.push(line.new(na, na, na, na, xloc = xloc.bar_time, color = color(na)))
            bbBullLineBtm2.push(line.new(na, na, na, na, xloc = xloc.bar_time, color = color(na)))
            bbBullLabels.push(label.new(na, na, text = '', color = color(na), textcolor = color.white, style = label.style_label_center, size = bbLabelSizeInput))
        for index = 1 to bbShowBearInput
            bbBearBoxA.push(box.new(na, na, na, na, xloc = xloc.bar_time, border_color = color(na), bgcolor = color(na)))
            bbBearBoxB.push(box.new(na, na, na, na, xloc = xloc.bar_time, border_color = color(na), bgcolor = color(na)))
            bbBearLineTop1.push(line.new(na, na, na, na, xloc = xloc.bar_time, color = color(na)))
            bbBearLineBtm1.push(line.new(na, na, na, na, xloc = xloc.bar_time, color = color(na)))
            bbBearLineTop2.push(line.new(na, na, na, na, xloc = xloc.bar_time, color = color(na)))
            bbBearLineBtm2.push(line.new(na, na, na, na, xloc = xloc.bar_time, color = color(na)))
            bbBearLabels.push(label.new(na, na, text = '', color = color(na), textcolor = color.white, style = label.style_label_center, size = bbLabelSizeInput))

bearishOrderBlockMitigationSource = orderBlockMitigationInput == CLOSE ? close : high
bullishOrderBlockMitigationSource = orderBlockMitigationInput == CLOSE ? close : low
atrMeasure = ta.atr(200)
volatilityMeasure = orderBlockFilterInput == ATR ? atrMeasure : ta.cum(ta.tr) / bar_index
highVolatilityBar = (high - low) >= (2 * volatilityMeasure)
parsedHigh = highVolatilityBar ? low : high
parsedLow = highVolatilityBar ? high : low

parsedHighs.push(parsedHigh)
parsedLows.push(parsedLow)
highs.push(high)
lows.push(low)
times.push(time)

// Cap memory/CPU cost: once the buffer exceeds the configured size, drop the oldest bar
if parsedHighs.size() > historyBufferInput
    parsedHighs.shift()
    parsedLows.shift()
    highs.shift()
    lows.shift()
    times.shift()
    trimOffset += 1

// Translates an absolute bar_index into a position inside the (possibly trimmed) buffer arrays
toBufIndex(int bi) => math.max(bi - trimOffset, 0)

//---------------------------------------------------------------------------------------------------------------------
// SMC USER-DEFINED FUNCTIONS
//---------------------------------------------------------------------------------------------------------------------
leg(int size) =>
    var leg = 0
    newLegHigh = high[size] > ta.highest(size)
    newLegLow = low[size] < ta.lowest(size)

    if newLegHigh
        leg := BEARISH_LEG
    else if newLegLow
        leg := BULLISH_LEG
    leg

startOfNewLeg(int leg) => ta.change(leg) != 0
startOfBearishLeg(int leg) => ta.change(leg) == -1
startOfBullishLeg(int leg) => ta.change(leg) == +1

drawLabel(int labelTime, float labelPrice, string tag, color labelColor, string labelStyle) =>
    var label l_abel = na

    if modeInput == PRESENT
        l_abel.delete()

    l_abel := label.new(chart.point.new(labelTime, na, labelPrice), tag, xloc.bar_time, color = color(na), textcolor = labelColor, style = labelStyle, size = size.small)

drawEqualHighLow(pivot p_ivot, float level, int size, bool equalHigh) =>
    equalDisplay e_qualDisplay = equalHigh ? equalHighDisplay : equalLowDisplay

    string tag = 'EQL'
    color equalColor = swingBullishColor
    string labelStyle = label.style_label_up

    if equalHigh
        tag := 'EQH'
        equalColor := swingBearishColor
        labelStyle := label.style_label_down

    if modeInput == PRESENT
        line.delete(e_qualDisplay.l_ine)
        label.delete(e_qualDisplay.l_abel)

    e_qualDisplay.l_ine := line.new(chart.point.new(p_ivot.barTime, na, p_ivot.currentLevel), chart.point.new(time[size], na, level), xloc = xloc.bar_time, color = equalColor, style = line.style_dotted)
    labelPosition = math.round(0.5 * (p_ivot.barIndex + bar_index - size))
    e_qualDisplay.l_abel := label.new(chart.point.new(na, labelPosition, level), tag, xloc.bar_index, color = color(na), textcolor = equalColor, style = labelStyle, size = equalHighsLowsSizeInput)

getCurrentStructure(int size, bool equalHighLow = false, bool internal = false) =>
    currentLeg = leg(size)
    newPivot = startOfNewLeg(currentLeg)
    pivotLow = startOfBullishLeg(currentLeg)
    pivotHigh = startOfBearishLeg(currentLeg)

    if newPivot
        if pivotLow
            pivot p_ivot = equalHighLow ? equalLow : internal ? internalLow : swingLow

            if equalHighLow and math.abs(p_ivot.currentLevel - low[size]) < equalHighsLowsThresholdInput * atrMeasure
                drawEqualHighLow(p_ivot, low[size], size, false)
                currentAlerts.equalLows := true

            p_ivot.lastLevel := p_ivot.currentLevel
            p_ivot.currentLevel := low[size]
            p_ivot.crossed := false
            p_ivot.barTime := time[size]
            p_ivot.barIndex := bar_index[size]

            if not equalHighLow and not internal
                trailing.bottom := p_ivot.currentLevel
                trailing.barTime := p_ivot.barTime
                trailing.barIndex := p_ivot.barIndex
                trailing.lastBottomTime := p_ivot.barTime

            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel < p_ivot.lastLevel ? 'LL' : 'HL', swingBullishColor, label.style_label_up)
        else
            pivot p_ivot = equalHighLow ? equalHigh : internal ? internalHigh : swingHigh

            if equalHighLow and math.abs(p_ivot.currentLevel - high[size]) < equalHighsLowsThresholdInput * atrMeasure
                drawEqualHighLow(p_ivot, high[size], size, true)
                currentAlerts.equalHighs := true

            p_ivot.lastLevel := p_ivot.currentLevel
            p_ivot.currentLevel := high[size]
            p_ivot.crossed := false
            p_ivot.barTime := time[size]
            p_ivot.barIndex := bar_index[size]

            if not equalHighLow and not internal
                trailing.top := p_ivot.currentLevel
                trailing.barTime := p_ivot.barTime
                trailing.barIndex := p_ivot.barIndex
                trailing.lastTopTime := p_ivot.barTime

            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel > p_ivot.lastLevel ? 'HH' : 'LH', swingBearishColor, label.style_label_down)

drawStructure(pivot p_ivot, string tag, color structureColor, string lineStyle, string labelStyle, string labelSize) =>
    var line l_ine = line.new(na, na, na, na, xloc = xloc.bar_time)
    var label l_abel = label.new(na, na)

    if modeInput == PRESENT
        l_ine.delete()
        l_abel.delete()

    l_ine := line.new(chart.point.new(p_ivot.barTime, na, p_ivot.currentLevel), chart.point.new(time, na, p_ivot.currentLevel), xloc.bar_time, color = structureColor, style = lineStyle)
    l_abel := label.new(chart.point.new(na, math.round(0.5 * (p_ivot.barIndex + bar_index)), p_ivot.currentLevel), tag, xloc.bar_index, color = color(na), textcolor = structureColor, style = labelStyle, size = labelSize)

deleteOrderBlocks(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks

    // Iterate backwards so removing an element mid-loop never skips the one that shifts into its place
    if orderBlocks.size() > 0
        for i = orderBlocks.size() - 1 to 0
            orderBlock eachOrderBlock = orderBlocks.get(i)
            bool crossedOderBlock = false

            if bearishOrderBlockMitigationSource > eachOrderBlock.barHigh and eachOrderBlock.bias == BEARISH
                crossedOderBlock := true
                if internal
                    currentAlerts.internalBearishOrderBlock := true
                else
                    currentAlerts.swingBearishOrderBlock := true
            else if bullishOrderBlockMitigationSource < eachOrderBlock.barLow and eachOrderBlock.bias == BULLISH
                crossedOderBlock := true
                if internal
                    currentAlerts.internalBullishOrderBlock := true
                else
                    currentAlerts.swingBullishOrderBlock := true

            if crossedOderBlock
                orderBlocks.remove(i)

storeOrdeBlock(pivot p_ivot, bool internal = false, int bias) =>
    if (not internal and showSwingOrderBlocksInput) or (internal and showInternalOrderBlocksInput)

        array<float> a_rray = na
        int parsedIndex = na

        int fromIndex = toBufIndex(p_ivot.barIndex)
        int toIndex = toBufIndex(bar_index)

        if bias == BEARISH
            a_rray := parsedHighs.slice(fromIndex, toIndex)
            parsedIndex := fromIndex + a_rray.indexof(a_rray.max())
        else
            a_rray := parsedLows.slice(fromIndex, toIndex)
            parsedIndex := fromIndex + a_rray.indexof(a_rray.min())

        orderBlock o_rderBlock = orderBlock.new(parsedHighs.get(parsedIndex), parsedLows.get(parsedIndex), times.get(parsedIndex), bias)
        array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks

        if orderBlocks.size() >= 100
            orderBlocks.pop()
        orderBlocks.unshift(o_rderBlock)

drawOrderBlocks(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    array<label> l_abels = internal ? internalOrderBlocksLabels : swingOrderBlocksLabels
    orderBlocksSize = orderBlocks.size()

    if orderBlocksSize > 0
        maxOrderBlocks = internal ? internalOrderBlocksSizeInput : swingOrderBlocksSizeInput
        array<orderBlock> parsedOrdeBlocks = orderBlocks.slice(0, math.min(maxOrderBlocks, orderBlocksSize))
        array<box> b_oxes = internal ? internalOrderBlocksBoxes : swingOrderBlocksBoxes

        for [index, eachOrderBlock] in parsedOrdeBlocks
            orderBlockColor = styleInput == MONOCHROME ? (eachOrderBlock.bias == BEARISH ? color.new(MONO_BEARISH, 80) : color.new(MONO_BULLISH, 80)) : internal ? (eachOrderBlock.bias == BEARISH ? internalBearishOrderBlockColor : internalBullishOrderBlockColor) : (eachOrderBlock.bias == BEARISH ? swingBearishOrderBlockColor : swingBullishOrderBlockColor)
            bool biasVisible = eachOrderBlock.bias == BEARISH ? (internal ? showInternalBearishOBInput : showSwingBearishOBInput) : (internal ? showInternalBullishOBInput : showSwingBullishOBInput)

            box b_ox = b_oxes.get(index)
            label l_abel = l_abels.get(index)

            if biasVisible
                b_ox.set_top_left_point(chart.point.new(eachOrderBlock.barTime, na, eachOrderBlock.barHigh))
                b_ox.set_bottom_right_point(chart.point.new(last_bar_time, na, eachOrderBlock.barLow))
                b_ox.set_border_color(internal ? na : orderBlockColor)
                b_ox.set_bgcolor(orderBlockColor)

                l_abel.set_point(chart.point.new(na, last_bar_index, 0.5 * (eachOrderBlock.barHigh + eachOrderBlock.barLow)))
                l_abel.set_text(showObLabelsInput ? (eachOrderBlock.bias == BEARISH ? 'Bear OB' : 'Bull OB') : '')
                l_abel.set_textcolor(color.new(orderBlockColor, 0))
                l_abel.set_size(obLabelSizeInput)
            else
                b_ox.set_border_color(color(na))
                b_ox.set_bgcolor(color(na))
                l_abel.set_text('')

        if l_abels.size() > parsedOrdeBlocks.size()
            for i = parsedOrdeBlocks.size() to l_abels.size() - 1
                l_abels.get(i).set_text('')
    else
        for eachLabel in l_abels
            eachLabel.set_text('')

displayStructure(bool internal = false) =>
    var bullishBar = true
    var bearishBar = true

    if internalFilterConfluenceInput
        bullishBar := high - math.max(close, open) > math.min(close, open - low)
        bearishBar := high - math.max(close, open) < math.min(close, open - low)

    pivot p_ivot = internal ? internalHigh : swingHigh
    trend t_rend = internal ? internalTrend : swingTrend

    lineStyle = internal ? line.style_dashed : line.style_solid
    labelSize = internal ? internalStructureSize : swingStructureSize

    extraCondition = internal ? internalHigh.currentLevel != swingHigh.currentLevel and bullishBar : true
    bullishColor = styleInput == MONOCHROME ? MONO_BULLISH : internal ? internalBullColorInput : swingBullColorInput

    if ta.crossover(close, p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BEARISH ? CHOCH : BOS

        if internal
            currentAlerts.internalBullishCHoCH := tag == CHOCH
            currentAlerts.internalBullishBOS := tag == BOS
        else
            currentAlerts.swingBullishCHoCH := tag == CHOCH
            currentAlerts.swingBullishBOS := tag == BOS

        p_ivot.crossed := true
        t_rend.bias := BULLISH

        displayCondition = internal ? showInternalsInput and (showInternalBullInput == ALL or (showInternalBullInput == BOS and tag != CHOCH) or (showInternalBullInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBullInput == ALL or (showSwingBullInput == BOS and tag != CHOCH) or (showSwingBullInput == CHOCH and tag == CHOCH))

        if displayCondition
            drawStructure(p_ivot, tag, bullishColor, lineStyle, label.style_label_down, labelSize)

        if (internal and showInternalOrderBlocksInput) or (not internal and showSwingOrderBlocksInput)
            storeOrdeBlock(p_ivot, internal, BULLISH)

    p_ivot := internal ? internalLow : swingLow
    extraCondition := internal ? internalLow.currentLevel != swingLow.currentLevel and bearishBar : true
    bearishColor = styleInput == MONOCHROME ? MONO_BEARISH : internal ? internalBearColorInput : swingBearColorInput

    if ta.crossunder(close, p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BULLISH ? CHOCH : BOS

        if internal
            currentAlerts.internalBearishCHoCH := tag == CHOCH
            currentAlerts.internalBearishBOS := tag == BOS
        else
            currentAlerts.swingBearishCHoCH := tag == CHOCH
            currentAlerts.swingBearishBOS := tag == BOS

        p_ivot.crossed := true
        t_rend.bias := BEARISH

        displayCondition = internal ? showInternalsInput and (showInternalBearInput == ALL or (showInternalBearInput == BOS and tag != CHOCH) or (showInternalBearInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBearInput == ALL or (showSwingBearInput == BOS and tag != CHOCH) or (showSwingBearInput == CHOCH and tag == CHOCH))

        if displayCondition
            drawStructure(p_ivot, tag, bearishColor, lineStyle, label.style_label_up, labelSize)

        if (internal and showInternalOrderBlocksInput) or (not internal and showSwingOrderBlocksInput)
            storeOrdeBlock(p_ivot, internal, BEARISH)

// FIX: the right edge of the box used (time - time[1]) as "one bar width". On the first bar after an
// overnight / weekend / holiday gap that value is the whole closed period, so the box was pushed far to
// the right (looking like it was extended to the current candle). A fixed bar duration is used instead.
fairValueGapBox(leftTime, rightTime, topPrice, bottomPrice, boxColor) =>
    int barMs = timeframe.in_seconds(fairValueGapsTimeframeInput == '' ? timeframe.period : fairValueGapsTimeframeInput) * 1000
    box.new(chart.point.new(leftTime, na, topPrice), chart.point.new(rightTime + fairValueGapsExtendInput * barMs, na, bottomPrice), xloc = xloc.bar_time, border_color = boxColor, bgcolor = boxColor)

deleteFairValueGaps() =>
    if fairValueGaps.size() > 0
        for i = fairValueGaps.size() - 1 to 0
            fairValueGap eachFairValueGap = fairValueGaps.get(i)
            if (low < eachFairValueGap.bottom and eachFairValueGap.bias == BULLISH) or (high > eachFairValueGap.top and eachFairValueGap.bias == BEARISH)
                eachFairValueGap.topBox.delete()
                eachFairValueGap.bottomBox.delete()
                fairValueGaps.remove(i)

// Instantly hides/shows already-plotted FVG boxes when the Show Bullish/Bearish FVG toggles change
syncFvgVisibility() =>
    if fairValueGaps.size() > 0
        for eachFairValueGap in fairValueGaps
            bool visible = eachFairValueGap.bias == BULLISH ? showBullishFVGInput : showBearishFVGInput
            color baseColor = eachFairValueGap.bias == BULLISH ? fairValueGapBullishColor : fairValueGapBearishColor
            color applied = visible ? baseColor : color(na)
            eachFairValueGap.topBox.set_border_color(applied)
            eachFairValueGap.topBox.set_bgcolor(applied)
            eachFairValueGap.bottomBox.set_border_color(applied)
            eachFairValueGap.bottomBox.set_bgcolor(applied)

// "Extend FVG to Current Bar": stretches every non mitigated FVG box to the current candle (last bar only)
updateFvgStyle() =>
    if showFvgStyleInput and fairValueGaps.size() > 0
        for eachFairValueGap in fairValueGaps
            eachFairValueGap.topBox.set_right(time)
            eachFairValueGap.bottomBox.set_right(time)

drawFairValueGaps() =>
    [lastClose, lastOpen, lastTime, currentHigh, currentLow, currentTime, last2High, last2Low] = request.security(syminfo.tickerid, fairValueGapsTimeframeInput, [close[1], open[1], time[1], high[0], low[0], time[0], high[2], low[2]], lookahead = barmerge.lookahead_on)

    barDeltaPercent = (lastClose - lastOpen) / (lastOpen * 100)
    newTimeframe = timeframe.change(fairValueGapsTimeframeInput)
    threshold = fairValueGapsThresholdInput ? ta.cum(math.abs(newTimeframe ? barDeltaPercent : 0)) / bar_index * 2 : 0

    bullishFairValueGap = currentLow > last2High and lastClose > last2High and barDeltaPercent > threshold and newTimeframe
    bearishFairValueGap = currentHigh < last2Low and lastClose < last2Low and -barDeltaPercent > threshold and newTimeframe

    if bullishFairValueGap
        currentAlerts.bullishFairValueGap := true
        fairValueGaps.unshift(fairValueGap.new(currentLow, last2High, BULLISH, fairValueGapBox(lastTime, currentTime, currentLow, math.avg(currentLow, last2High), fairValueGapBullishColor), fairValueGapBox(lastTime, currentTime, math.avg(currentLow, last2High), last2High, fairValueGapBullishColor), lastTime))
    if bearishFairValueGap
        currentAlerts.bearishFairValueGap := true
        fairValueGaps.unshift(fairValueGap.new(currentHigh, last2Low, BEARISH, fairValueGapBox(lastTime, currentTime, currentHigh, math.avg(currentHigh, last2Low), fairValueGapBearishColor), fairValueGapBox(lastTime, currentTime, math.avg(currentHigh, last2Low), last2Low, fairValueGapBearishColor), lastTime))

// ---------------------------------------------------------------------------------------------------------------------
// HTF FVG FUNCTIONS
// ---------------------------------------------------------------------------------------------------------------------
htfFvgData() =>
    bool bull = low[1] > high[3] and close[2] > high[3]
    bool bear = high[1] < low[3] and close[2] < low[3]
    [bull, bear, low[1], high[3], low[3], high[1], time[3], time]

htfText(string tf) =>
    int sec = timeframe.in_seconds(tf)
    string out = ''
    if sec % 86400 == 0
        int n = int(sec / 86400)
        out := str.tostring(n) + (n == 1 ? ' Day' : ' Days')
    else if sec % 3600 == 0
        int n = int(sec / 3600)
        out := str.tostring(n) + (n == 1 ? ' Hour' : ' Hours')
    else
        out := str.tostring(int(sec / 60)) + ' Min'
    out

updateHtfLabel(htfFairValueGap g, int x) =>
    g.l_abel.set_point(chart.point.new(x, na, 0.5 * (g.top + g.bottom)))

updateHtfFvg(array<htfFairValueGap> gaps, bool enabled, string tf, bool isNew, bool bull, bool bear, float bTop, float bBottom, float rTop, float rBottom, int leftTime, color bullBorder, color bearBorder, color bullBox, color bearBox) =>
    if enabled
        if gaps.size() > 0
            for i = gaps.size() - 1 to 0
                htfFairValueGap g = gaps.get(i)
                if g.active
                    bool mitigated = (g.bias == BULLISH and low < g.bottom) or (g.bias == BEARISH and high > g.top)
                    if mitigated
                        if htfDeleteMitigatedInput
                            g.b_ox.delete()
                            g.l_abel.delete()
                            gaps.remove(i)
                        else
                            g.active := false
                            g.b_ox.set_extend(extend.none)
                            g.b_ox.set_right(time)
                            updateHtfLabel(g, time)
                    else if htfExtendInput
                        updateHtfLabel(g, time)

        if isNew and (bull or bear)
            float topPrice = bull ? bTop : rTop
            float bottomPrice = bull ? bBottom : rBottom
            int biasValue = bull ? BULLISH : BEARISH
            color borderColor = bull ? bullBorder : bearBorder
            color boxColor = bull ? bullBox : bearBox
            string fvgText = htfText(tf) + (bull ? ' Bull HTF FVG' : ' Bear HTF FVG')

            box newBox = box.new(leftTime, topPrice, time, bottomPrice, border_color = borderColor, bgcolor = boxColor, extend = htfExtendInput ? extend.right : extend.none, xloc = xloc.bar_time)
            int labelTime = htfExtendInput ? time : math.round(0.5 * (leftTime + time))
            label newLabel = label.new(chart.point.new(labelTime, na, 0.5 * (topPrice + bottomPrice)), htfShowTextInput ? fvgText : '', xloc.bar_time, color = color(na), textcolor = color.new(borderColor, 0), style = label.style_label_center, size = htfTextSizeInput)
            gaps.push(htfFairValueGap.new(topPrice, bottomPrice, biasValue, newBox, true, newLabel))

            if gaps.size() > htfMaxInput
                htfFairValueGap oldest = gaps.shift()
                oldest.b_ox.delete()
                oldest.l_abel.delete()

// ---------------------------------------------------------------------------------------------------------------------
// HTF OB FUNCTIONS
// ---------------------------------------------------------------------------------------------------------------------
htfObData(float impulseMult) =>
    float atrValue = ta.atr(14)[1]
    float bodySize = math.abs(close[1] - open[1])
    bool strongMove = impulseMult <= 0 or bodySize >= impulseMult * atrValue
    bool obBull = close[2] < open[2] and close[1] > open[1] and close[1] > high[2] and strongMove
    bool obBear = close[2] > open[2] and close[1] < open[1] and close[1] < low[2] and strongMove
    [obBull, obBear, high[2], low[2], time[2], time]

updateHtfOb(array<htfFairValueGap> obs, bool enabled, string tf, bool isNew, bool bull, bool bear, float oTop, float oBottom, int leftTime, color bullBorder, color bearBorder, color bullBox, color bearBox) =>
    if enabled
        if obs.size() > 0
            for i = obs.size() - 1 to 0
                htfFairValueGap g = obs.get(i)
                if g.active
                    bool mitigated = (g.bias == BULLISH and bullishOrderBlockMitigationSource < g.bottom) or (g.bias == BEARISH and bearishOrderBlockMitigationSource > g.top)
                    if mitigated
                        if htfObDeleteMitigatedInput
                            g.b_ox.delete()
                            g.l_abel.delete()
                            obs.remove(i)
                        else
                            g.active := false
                            g.b_ox.set_extend(extend.none)
                            g.b_ox.set_right(time)
                            updateHtfLabel(g, time)
                    else if htfObExtendInput
                        updateHtfLabel(g, time)

        if isNew and (bull or bear)
            int biasValue = bull ? BULLISH : BEARISH
            color borderColor = bull ? bullBorder : bearBorder
            color boxColor = bull ? bullBox : bearBox
            string obText = htfText(tf) + (bull ? ' Bull HTF OB' : ' Bear HTF OB')

            box newBox = box.new(leftTime, oTop, time, oBottom, border_color = borderColor, bgcolor = boxColor, extend = htfObExtendInput ? extend.right : extend.none, xloc = xloc.bar_time)
            int labelTime = htfObExtendInput ? time : math.round(0.5 * (leftTime + time))
            label newLabel = label.new(chart.point.new(labelTime, na, 0.5 * (oTop + oBottom)), htfObShowTextInput ? obText : '', xloc.bar_time, color = color(na), textcolor = color.new(borderColor, 0), style = label.style_label_center, size = htfObTextSizeInput)
            obs.push(htfFairValueGap.new(oTop, oBottom, biasValue, newBox, true, newLabel))

            if obs.size() > htfObMaxInput
                htfFairValueGap oldest = obs.shift()
                oldest.b_ox.delete()
                oldest.l_abel.delete()

// Instantly hides/shows already-plotted HTF FVG / HTF OB boxes when their bull/bear toggles change
syncHtfVisibility(array<htfFairValueGap> arr, bool showBull, bool showBear, color bullBorder, color bearBorder, color bullBox, color bearBox) =>
    if arr.size() > 0
        for eachG in arr
            bool visible = eachG.bias == BULLISH ? showBull : showBear
            color borderColor = eachG.bias == BULLISH ? bullBorder : bearBorder
            color boxColor = eachG.bias == BULLISH ? bullBox : bearBox
            if visible
                eachG.b_ox.set_border_color(borderColor)
                eachG.b_ox.set_bgcolor(boxColor)
                eachG.l_abel.set_textcolor(color.new(borderColor, 0))
            else
                eachG.b_ox.set_border_color(color(na))
                eachG.b_ox.set_bgcolor(color(na))
                eachG.l_abel.set_textcolor(color(na))

getStyle(string style) =>
    switch style
        SOLID => line.style_solid
        DASHED => line.style_dashed
        DOTTED => line.style_dotted

drawLevels(string timeframe, bool sameTimeframe, string style, color levelColor) =>
    [topLevel, bottomLevel, leftTime, rightTime] = request.security(syminfo.tickerid, timeframe, [high[1], low[1], time[1], time], lookahead = barmerge.lookahead_on)

    float parsedTop = sameTimeframe ? high : topLevel
    float parsedBottom = sameTimeframe ? low : bottomLevel

    int parsedLeftTime = sameTimeframe ? time : leftTime
    int parsedRightTime = sameTimeframe ? time : rightTime

    int parsedTopTime = time
    int parsedBottomTime = time

    if not sameTimeframe
        int leftIndex = times.binary_search_rightmost(parsedLeftTime)
        int rightIndex = times.binary_search_rightmost(parsedRightTime)

        array<int> timeArray = times.slice(leftIndex, rightIndex)
        array<float> topArray = highs.slice(leftIndex, rightIndex)
        array<float> bottomArray = lows.slice(leftIndex, rightIndex)

        parsedTopTime := timeArray.size() > 0 ? timeArray.get(topArray.indexof(topArray.max())) : initialTime
        parsedBottomTime := timeArray.size() > 0 ? timeArray.get(bottomArray.indexof(bottomArray.min())) : initialTime

    var line topLine = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var line bottomLine = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var label topLabel = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}H', timeframe), color = color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)
    var label bottomLabel = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}L', timeframe), color = color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)

    topLine.set_first_point(chart.point.new(parsedTopTime, na, parsedTop))
    topLine.set_second_point(chart.point.new(last_bar_time + 20 * (time - time[1]), na, parsedTop))
    topLabel.set_point(chart.point.new(last_bar_time + 20 * (time - time[1]), na, parsedTop))

    bottomLine.set_first_point(chart.point.new(parsedBottomTime, na, parsedBottom))
    bottomLine.set_second_point(chart.point.new(last_bar_time + 20 * (time - time[1]), na, parsedBottom))
    bottomLabel.set_point(chart.point.new(last_bar_time + 20 * (time - time[1]), na, parsedBottom))

higherTimeframe(string timeframe) => timeframe.in_seconds() > timeframe.in_seconds(timeframe)

updateTrailingExtremes() =>
    trailing.top := math.max(high, trailing.top)
    trailing.lastTopTime := trailing.top == high ? time : trailing.lastTopTime
    trailing.bottom := math.min(low, trailing.bottom)
    trailing.lastBottomTime := trailing.bottom == low ? time : trailing.lastBottomTime

drawHighLowSwings() =>
    var line topLine = line.new(na, na, na, na, color = swingBearishColor, xloc = xloc.bar_time)
    var line bottomLine = line.new(na, na, na, na, color = swingBullishColor, xloc = xloc.bar_time)
    var label topLabel = label.new(na, na, color = color(na), textcolor = swingBearishColor, xloc = xloc.bar_time, style = label.style_label_down, size = size.tiny)
    var label bottomLabel = label.new(na, na, color = color(na), textcolor = swingBullishColor, xloc = xloc.bar_time, style = label.style_label_up, size = size.tiny)

    rightTimeBar = last_bar_time + 20 * (time - time[1])

    topLine.set_first_point(chart.point.new(trailing.lastTopTime, na, trailing.top))
    topLine.set_second_point(chart.point.new(rightTimeBar, na, trailing.top))
    topLabel.set_point(chart.point.new(rightTimeBar, na, trailing.top))
    topLabel.set_text(swingTrend.bias == BEARISH ? 'Strong High' : 'Weak High')
    topLabel.set_size(highLowLabelSizeInput)

    bottomLine.set_first_point(chart.point.new(trailing.lastBottomTime, na, trailing.bottom))
    bottomLine.set_second_point(chart.point.new(rightTimeBar, na, trailing.bottom))
    bottomLabel.set_point(chart.point.new(rightTimeBar, na, trailing.bottom))
    bottomLabel.set_text(swingTrend.bias == BULLISH ? 'Strong Low' : 'Weak Low')
    bottomLabel.set_size(highLowLabelSizeInput)

drawZone(float labelLevel, int labelIndex, float top, float bottom, string tag, color zoneColor, string style, bool visible, string labelSize) =>
    var label l_abel = label.new(na, na, text = tag, color = color(na), textcolor = zoneColor, style = style, size = size.small)
    var box b_ox = box.new(na, na, na, na, bgcolor = color.new(zoneColor, 80), border_color = color(na), xloc = xloc.bar_time)

    if visible
        b_ox.set_top_left_point(chart.point.new(trailing.barTime, na, top))
        b_ox.set_bottom_right_point(chart.point.new(last_bar_time, na, bottom))
        b_ox.set_bgcolor(color.new(zoneColor, 80))
        l_abel.set_point(chart.point.new(na, labelIndex, labelLevel))
        l_abel.set_text(showZoneLabelsInput ? tag : '')
        l_abel.set_textcolor(showZoneLabelsInput ? zoneColor : color(na))
        l_abel.set_size(labelSize)
    else
        b_ox.set_bgcolor(color(na))
        l_abel.set_text('')
        l_abel.set_textcolor(color(na))

drawPremiumDiscountZones() =>
    drawZone(trailing.top, math.round(0.5 * (trailing.barIndex + last_bar_index)), trailing.top, 0.95 * trailing.top + 0.05 * trailing.bottom, 'Premium', premiumZoneColor, label.style_label_down, showPremiumZoneInput, zoneLabelSizeInput)

    equilibriumLevel = math.avg(trailing.top, trailing.bottom)
    drawZone(equilibriumLevel, math.round(0.5 * (trailing.barIndex + last_bar_index)), 0.525 * trailing.top + 0.475 * trailing.bottom, 0.525 * trailing.bottom + 0.475 * trailing.top, 'Equilibrium', equilibriumZoneColorInput, label.style_label_center, showEquilibriumZoneInput, zoneLabelSizeInput)

    drawZone(trailing.bottom, math.round(0.5 * (trailing.barIndex + last_bar_index)), 0.95 * trailing.bottom + 0.05 * trailing.top, trailing.bottom, 'Discount', discountZoneColor, label.style_label_up, showDiscountZoneInput, zoneLabelSizeInput)

//---------------------------------------------------------------------------------------------------------------------
// SMC EXECUTION
//---------------------------------------------------------------------------------------------------------------------
parsedOpen = showTrendInput ? open : na
candleColor = internalTrend.bias == BULLISH ? swingBullishColor : swingBearishColor
plotcandle(parsedOpen, high, low, close, color = candleColor, wickcolor = candleColor, bordercolor = candleColor, display = display.pane)

if showHighLowSwingsInput or showPremiumDiscountZonesInput
    updateTrailingExtremes()

    if showHighLowSwingsInput
        drawHighLowSwings()

    if showPremiumDiscountZonesInput
        drawPremiumDiscountZones()

if showFairValueGapsInput
    deleteFairValueGaps()

getCurrentStructure(swingsLengthInput, false)
getCurrentStructure(internalStructureLengthInput, false, true)

if showEqualHighsLowsInput
    getCurrentStructure(equalHighsLowsLengthInput, true)

if showInternalsInput or showInternalOrderBlocksInput or showTrendInput
    displayStructure(true)

if showStructureInput or showSwingOrderBlocksInput or showHighLowSwingsInput
    displayStructure()

if showInternalOrderBlocksInput
    deleteOrderBlocks(true)

if showSwingOrderBlocksInput
    deleteOrderBlocks()

if showFairValueGapsInput
    drawFairValueGaps()
    syncFvgVisibility()
    if barstate.islast
        updateFvgStyle()

// HTF FVG execution
htf1Valid = timeframe.in_seconds(htf1Input) >= timeframe.in_seconds(timeframe.period)
htf2Valid = timeframe.in_seconds(htf2Input) >= timeframe.in_seconds(timeframe.period)

[h1Bull, h1Bear, h1BTop, h1BBottom, h1RTop, h1RBottom, h1Left, h1Time] = request.security(syminfo.tickerid, htf1Input, htfFvgData(), lookahead = barmerge.lookahead_off)
[h2Bull, h2Bear, h2BTop, h2BBottom, h2RTop, h2RBottom, h2Left, h2Time] = request.security(syminfo.tickerid, htf2Input, htfFvgData(), lookahead = barmerge.lookahead_off)

h1New = ta.change(h1Time) != 0
h2New = ta.change(h2Time) != 0

updateHtfFvg(htf1Gaps, showHTF1Input and htf1Valid, htf1Input, h1New, h1Bull, h1Bear, h1BTop, h1BBottom, h1RTop, h1RBottom, h1Left, htf1BullBorderInput, htf1BearBorderInput, htf1BullBoxInput, htf1BearBoxInput)
updateHtfFvg(htf2Gaps, showHTF2Input and htf2Valid, htf2Input, h2New, h2Bull, h2Bear, h2BTop, h2BBottom, h2RTop, h2RBottom, h2Left, htf2BullBorderInput, htf2BearBorderInput, htf2BullBoxInput, htf2BearBoxInput)

syncHtfVisibility(htf1Gaps, showHtf1BullFVGInput, showHtf1BearFVGInput, htf1BullBorderInput, htf1BearBorderInput, htf1BullBoxInput, htf1BearBoxInput)
syncHtfVisibility(htf2Gaps, showHtf2BullFVGInput, showHtf2BearFVGInput, htf2BullBorderInput, htf2BearBorderInput, htf2BullBoxInput, htf2BearBoxInput)

currentAlerts.htf1BullishFVG := showHTF1Input and htf1Valid and h1New and h1Bull
currentAlerts.htf1BearishFVG := showHTF1Input and htf1Valid and h1New and h1Bear
currentAlerts.htf2BullishFVG := showHTF2Input and htf2Valid and h2New and h2Bull
currentAlerts.htf2BearishFVG := showHTF2Input and htf2Valid and h2New and h2Bear

// HTF OB execution
htfOb1Valid = timeframe.in_seconds(htfOb1Input) >= timeframe.in_seconds(timeframe.period)
htfOb2Valid = timeframe.in_seconds(htfOb2Input) >= timeframe.in_seconds(timeframe.period)

[o1Bull, o1Bear, o1Top, o1Bottom, o1Left, o1Time] = request.security(syminfo.tickerid, htfOb1Input, htfObData(htfObImpulseInput), lookahead = barmerge.lookahead_off)
[o2Bull, o2Bear, o2Top, o2Bottom, o2Left, o2Time] = request.security(syminfo.tickerid, htfOb2Input, htfObData(htfObImpulseInput), lookahead = barmerge.lookahead_off)

o1New = ta.change(o1Time) != 0
o2New = ta.change(o2Time) != 0

updateHtfOb(htf1Obs, showHTFOb1Input and htfOb1Valid, htfOb1Input, o1New, o1Bull, o1Bear, o1Top, o1Bottom, o1Left, htfOb1BullBorderInput, htfOb1BearBorderInput, htfOb1BullBoxInput, htfOb1BearBoxInput)
updateHtfOb(htf2Obs, showHTFOb2Input and htfOb2Valid, htfOb2Input, o2New, o2Bull, o2Bear, o2Top, o2Bottom, o2Left, htfOb2BullBorderInput, htfOb2BearBorderInput, htfOb2BullBoxInput, htfOb2BearBoxInput)

syncHtfVisibility(htf1Obs, showHtfOb1BullInput, showHtfOb1BearInput, htfOb1BullBorderInput, htfOb1BearBorderInput, htfOb1BullBoxInput, htfOb1BearBoxInput)
syncHtfVisibility(htf2Obs, showHtfOb2BullInput, showHtfOb2BearInput, htfOb2BullBorderInput, htfOb2BearBorderInput, htfOb2BullBoxInput, htfOb2BearBoxInput)

currentAlerts.htf1BullishOB := showHTFOb1Input and htfOb1Valid and o1New and o1Bull
currentAlerts.htf1BearishOB := showHTFOb1Input and htfOb1Valid and o1New and o1Bear
currentAlerts.htf2BullishOB := showHTFOb2Input and htfOb2Valid and o2New and o2Bull
currentAlerts.htf2BearishOB := showHTFOb2Input and htfOb2Valid and o2New and o2Bear

if barstate.islastconfirmedhistory or barstate.islast
    if showInternalOrderBlocksInput
        drawOrderBlocks(true)

    if showSwingOrderBlocksInput
        drawOrderBlocks()

lastBarIndex := currentBarIndex
currentBarIndex := bar_index
newBar = currentBarIndex != lastBarIndex

if barstate.islastconfirmedhistory or (barstate.isrealtime and newBar)
    if showDailyLevelsInput and not higherTimeframe('D')
        drawLevels('D', timeframe.isdaily, dailyLevelsStyleInput, dailyLevelsColorInput)

    if showWeeklyLevelsInput and not higherTimeframe('W')
        drawLevels('W', timeframe.isweekly, weeklyLevelsStyleInput, weeklyLevelsColorInput)

    if showMonthlyLevelsInput and not higherTimeframe('M')
        drawLevels('M', timeframe.ismonthly, monthlyLevelsStyleInput, monthlyLevelsColorInput)

//---------------------------------------------------------------------------------------------------------------------
// SMC BREAKER BLOCKS
//---------------------------------------------------------------------------------------------------------------------
type bbOb
    float top = na
    float btm = na
    int loc = bar_index
    bool breaker = false
    int break_loc = na

type bbSwing
    float y = na
    int x = na
    bool crossed = false

var array<bbOb> bbBullishObs = array.new<bbOb>(0)
var array<bbOb> bbBearishObs = array.new<bbOb>(0)

bbSwings(int len) =>
    var os = 0
    var bbSwing t = bbSwing.new(na, na)
    var bbSwing b = bbSwing.new(na, na)

    upper = ta.highest(len)
    lower = ta.lowest(len)

    os := high[len] > upper ? 0 : low[len] < lower ? 1 : os

    if os == 0 and os[1] != 0
        t := bbSwing.new(high[len], bar_index[len])

    if os == 1 and os[1] != 1
        b := bbSwing.new(low[len], bar_index[len])

    [t, b]

method bbNoTransp(color css) => color.rgb(color.r(css), color.g(css), color.b(css))

// Updates one slot's pooled box/line/label objects in place instead of deleting and recreating them
method bbApply(bbOb id, box boxA, box boxB, line lineTop1, line lineBtm1, line lineTop2, line lineBtm2, label lbl, string tag, color css, color breakCss) =>
    if id.breaker
        // pre-break segment (original OB span) - optional
        if bbShowPreBreakInput
            boxA.set_lefttop(id.loc, id.top)
            boxA.set_rightbottom(id.break_loc, id.btm)
            boxA.set_border_color(css.bbNoTransp())
            boxA.set_bgcolor(css)
            boxA.set_extend(extend.none)

            lineTop1.set_xy1(id.loc, id.top)
            lineTop1.set_xy2(id.break_loc, id.top)
            lineTop1.set_color(css.bbNoTransp())
            lineTop1.set_style(line.style_solid)
            lineTop1.set_extend(extend.none)

            lineBtm1.set_xy1(id.loc, id.btm)
            lineBtm1.set_xy2(id.break_loc, id.btm)
            lineBtm1.set_color(css.bbNoTransp())
            lineBtm1.set_style(line.style_solid)
            lineBtm1.set_extend(extend.none)
        else
            boxA.set_border_color(color(na))
            boxA.set_bgcolor(color(na))
            lineTop1.set_color(color(na))
            lineBtm1.set_color(color(na))

        // breaker zone (from break bar, extended right)
        boxB.set_lefttop(id.break_loc, id.top)
        boxB.set_rightbottom(time + 1, id.btm)
        boxB.set_border_color(breakCss.bbNoTransp())
        boxB.set_bgcolor(breakCss)
        boxB.set_extend(extend.right)

        lineTop2.set_xy1(id.break_loc, id.top)
        lineTop2.set_xy2(time + 1, id.top)
        lineTop2.set_color(breakCss.bbNoTransp())
        lineTop2.set_style(line.style_dashed)
        lineTop2.set_extend(extend.right)

        lineBtm2.set_xy1(id.break_loc, id.btm)
        lineBtm2.set_xy2(time + 1, id.btm)
        lineBtm2.set_color(breakCss.bbNoTransp())
        lineBtm2.set_style(line.style_dashed)
        lineBtm2.set_extend(extend.right)

        // breaker label (sits at the current candle, in the middle of the breaker zone)
        lbl.set_point(chart.point.new(na, last_bar_index, 0.5 * (id.top + id.btm)))
        lbl.set_text(bbShowTagInput ? tag : '')
        lbl.set_textcolor(breakCss.bbNoTransp())
        lbl.set_size(bbLabelSizeInput)
    else
        boxA.set_lefttop(id.loc, id.top)
        boxA.set_rightbottom(time, id.btm)
        boxA.set_border_color(color(na))
        boxA.set_bgcolor(css)
        boxA.set_extend(extend.right)

        boxB.set_border_color(color(na))
        boxB.set_bgcolor(color(na))

        lineTop1.set_xy1(id.loc, id.top)
        lineTop1.set_xy2(time, id.top)
        lineTop1.set_color(css.bbNoTransp())
        lineTop1.set_style(line.style_solid)
        lineTop1.set_extend(extend.right)

        lineBtm1.set_xy1(id.loc, id.btm)
        lineBtm1.set_xy2(time, id.btm)
        lineBtm1.set_color(css.bbNoTransp())
        lineBtm1.set_style(line.style_solid)
        lineBtm1.set_extend(extend.right)

        lineTop2.set_color(color(na))
        lineBtm2.set_color(color(na))
        lbl.set_text('')

// Hides a pooled slot that currently has no order block assigned to it
bbHideSlot(box boxA, box boxB, line lineTop1, line lineBtm1, line lineTop2, line lineBtm2, label lbl) =>
    boxA.set_border_color(color(na))
    boxA.set_bgcolor(color(na))
    boxB.set_border_color(color(na))
    boxB.set_bgcolor(color(na))
    lineTop1.set_color(color(na))
    lineBtm1.set_color(color(na))
    lineTop2.set_color(color(na))
    lineBtm2.set_color(color(na))
    lbl.set_text('')

bbN = bar_index
bbMax = bbUseBodyInput ? math.max(close, open) : high
bbMin = bbUseBodyInput ? math.min(close, open) : low

bbEffectiveLength = bbLengthSourceInput == 'Swing Structure' ? bbSwingLengthInput : bbLengthSourceInput == 'Internal Structure' ? bbInternalLengthInput : bbLengthInput

[bbTop, bbBtm] = bbSwings(bbEffectiveLength)

// Bullish OB
bbBullConf = 0

if close > bbTop.y and not bbTop.crossed
    bbTop.crossed := true

    minima = bbMax[1]
    maxima = bbMin[1]
    loc = time[1]

    for i = 1 to (bbN - bbTop.x) - 1
        minima := math.min(bbMin[i], minima)
        maxima := minima == bbMin[i] ? bbMax[i] : maxima
        loc := minima == bbMin[i] ? time[i] : loc
    bbBullishObs.unshift(bbOb.new(maxima, minima, loc))

if bbBullishObs.size() > 0
    for i = bbBullishObs.size() - 1 to 0
        element = bbBullishObs.get(i)

        if not element.breaker
            if math.min(close, open) < element.btm
                element.breaker := true
                element.break_loc := time
        else
            if close > element.top
                bbBullishObs.remove(i)
            else if i < bbShowBullInput and bbTop.y < element.top and bbTop.y > element.btm
                bbBullConf := 1

if bbBullConf > bbBullConf[1] and smc_f_on and smc_bb_master
    currentAlerts.bullishBreakerBlock := true
    if bbShowLabelsInput
        label.new(bbTop.x, bbTop.y, '▼', color = color(na), textcolor = bbBearCssInput.bbNoTransp(), style = label.style_label_down, size = size.tiny)

// Bearish OB
bbBearConf = 0

if close < bbBtm.y and not bbBtm.crossed
    bbBtm.crossed := true
    minima = bbMin[1]
    maxima = bbMax[1]
    loc = time[1]

    for i = 1 to (bbN - bbBtm.x) - 1
        maxima := math.max(bbMax[i], maxima)
        minima := maxima == bbMax[i] ? bbMin[i] : minima
        loc := maxima == bbMax[i] ? time[i] : loc

    bbBearishObs.unshift(bbOb.new(maxima, minima, loc))
if bbBearishObs.size() > 0
    for i = bbBearishObs.size() - 1 to 0
        element = bbBearishObs.get(i)

        if not element.breaker
            if math.max(close, open) > element.top
                element.breaker := true
                element.break_loc := time
        else
            if close < element.btm
                bbBearishObs.remove(i)
            else if i < bbShowBearInput and bbBtm.y > element.btm and bbBtm.y < element.top
                bbBearConf := 1

if bbBearConf > bbBearConf[1] and smc_f_on and smc_bb_master
    currentAlerts.bearishBreakerBlock := true
    if bbShowLabelsInput
        label.new(bbBtm.x, bbBtm.y, '▲', color = color(na), textcolor = bbBullCssInput.bbNoTransp(), style = label.style_label_up, size = size.tiny)

// Draw - breaker blocks only (unbroken OBs are skipped)
if barstate.islast and bbShowInput
    if bbShowBullInput > 0
        int bullSlot = 0
        if showBreakerBullishInput and bbBullishObs.size() > 0
            for i = 0 to bbBullishObs.size() - 1
                bbOb obj = bbBullishObs.get(i)
                if obj.breaker and bullSlot < bbShowBullInput
                    obj.bbApply(bbBullBoxA.get(bullSlot), bbBullBoxB.get(bullSlot), bbBullLineTop1.get(bullSlot), bbBullLineBtm1.get(bullSlot), bbBullLineTop2.get(bullSlot), bbBullLineBtm2.get(bullSlot), bbBullLabels.get(bullSlot), 'Bull BB', bbBullCssInput, bbBullBreakCssInput)
                    bullSlot += 1
        if bullSlot < bbShowBullInput
            for s = bullSlot to bbShowBullInput - 1
                bbHideSlot(bbBullBoxA.get(s), bbBullBoxB.get(s), bbBullLineTop1.get(s), bbBullLineBtm1.get(s), bbBullLineTop2.get(s), bbBullLineBtm2.get(s), bbBullLabels.get(s))

    if bbShowBearInput > 0
        int bearSlot = 0
        if showBreakerBearishInput and bbBearishObs.size() > 0
            for i = 0 to bbBearishObs.size() - 1
                bbOb obj = bbBearishObs.get(i)
                if obj.breaker and bearSlot < bbShowBearInput
                    obj.bbApply(bbBearBoxA.get(bearSlot), bbBearBoxB.get(bearSlot), bbBearLineTop1.get(bearSlot), bbBearLineBtm1.get(bearSlot), bbBearLineTop2.get(bearSlot), bbBearLineBtm2.get(bearSlot), bbBearLabels.get(bearSlot), 'Bear BB', bbBearCssInput, bbBearBreakCssInput)
                    bearSlot += 1
        if bearSlot < bbShowBearInput
            for s = bearSlot to bbShowBearInput - 1
                bbHideSlot(bbBearBoxA.get(s), bbBearBoxB.get(s), bbBearLineTop1.get(s), bbBearLineBtm1.get(s), bbBearLineTop2.get(s), bbBearLineBtm2.get(s), bbBearLabels.get(s))

//---------------------------------------------------------------------------------------------------------------------
// SMC ALERTS
// alert() based (does not count toward the 64 plot limit)
// Create the TradingView alert with Condition = this indicator and Any alert() function call
// Each event type can be switched on/off in the "Alert Filters" input group
//---------------------------------------------------------------------------------------------------------------------
smc_alert_gate = smc_f_on and smc_alert_master and alert_smc_events

f_dir_ok(bool isBull) =>
    af_smc_dir == 'Both' or (af_smc_dir == 'Bullish only' and isBull) or (af_smc_dir == 'Bearish only' and not isBull)

f_smc_alert(bool fire, bool enabled, bool isBull, string msg) =>
    if smc_alert_gate and fire and enabled and f_dir_ok(isBull)
        alert(msg, alert_frequency)

// per-feature enable = Alert Filter AND the feature's master switch
sa_int_bos = af_int_bos and smc_struct_master
sa_int_choch = af_int_choch and smc_struct_master
sa_sw_bos = af_sw_bos and smc_struct_master
sa_sw_choch = af_sw_choch and smc_struct_master
sa_ob = af_ob and smc_ob_master
sa_eq = af_eq and smc_eq_master
sa_fvg = af_fvg and smc_fvg_master
sa_htf_fvg = af_htf_fvg and smc_htf_fvg_master
sa_htf_ob = af_htf_ob and smc_htf_ob_master
sa_bb = af_bb and smc_bb_master

// Structure
f_smc_alert(currentAlerts.internalBullishBOS, sa_int_bos, true, 'Internal Bullish BOS formed')
f_smc_alert(currentAlerts.internalBearishBOS, sa_int_bos, false, 'Internal Bearish BOS formed')
f_smc_alert(currentAlerts.internalBullishCHoCH, sa_int_choch, true, 'Internal Bullish CHoCH formed')
f_smc_alert(currentAlerts.internalBearishCHoCH, sa_int_choch, false, 'Internal Bearish CHoCH formed')
f_smc_alert(currentAlerts.swingBullishBOS, sa_sw_bos, true, 'Bullish BOS formed')
f_smc_alert(currentAlerts.swingBearishBOS, sa_sw_bos, false, 'Bearish BOS formed')
f_smc_alert(currentAlerts.swingBullishCHoCH, sa_sw_choch, true, 'Bullish CHoCH formed')
f_smc_alert(currentAlerts.swingBearishCHoCH, sa_sw_choch, false, 'Bearish CHoCH formed')

// Order block breakouts
f_smc_alert(currentAlerts.internalBullishOrderBlock, sa_ob, true, 'Price broke bullish internal OB')
f_smc_alert(currentAlerts.internalBearishOrderBlock, sa_ob, false, 'Price broke bearish internal OB')
f_smc_alert(currentAlerts.swingBullishOrderBlock, sa_ob, true, 'Price broke bullish swing OB')
f_smc_alert(currentAlerts.swingBearishOrderBlock, sa_ob, false, 'Price broke bearish swing OB')

// Equal highs / lows
f_smc_alert(currentAlerts.equalHighs, sa_eq, false, 'Equal highs detected')
f_smc_alert(currentAlerts.equalLows, sa_eq, true, 'Equal lows detected')

// Fair value gaps
f_smc_alert(currentAlerts.bullishFairValueGap, sa_fvg, true, 'Bullish FVG formed')
f_smc_alert(currentAlerts.bearishFairValueGap, sa_fvg, false, 'Bearish FVG formed')

// HTF fair value gaps
f_smc_alert(currentAlerts.htf1BullishFVG, sa_htf_fvg, true, 'Bullish HTF1 FVG formed')
f_smc_alert(currentAlerts.htf1BearishFVG, sa_htf_fvg, false, 'Bearish HTF1 FVG formed')
f_smc_alert(currentAlerts.htf2BullishFVG, sa_htf_fvg, true, 'Bullish HTF2 FVG formed')
f_smc_alert(currentAlerts.htf2BearishFVG, sa_htf_fvg, false, 'Bearish HTF2 FVG formed')

// HTF order blocks
f_smc_alert(currentAlerts.htf1BullishOB, sa_htf_ob, true, 'Bullish HTF1 OB formed')
f_smc_alert(currentAlerts.htf1BearishOB, sa_htf_ob, false, 'Bearish HTF1 OB formed')
f_smc_alert(currentAlerts.htf2BullishOB, sa_htf_ob, true, 'Bullish HTF2 OB formed')
f_smc_alert(currentAlerts.htf2BearishOB, sa_htf_ob, false, 'Bearish HTF2 OB formed')

// Breaker blocks
f_smc_alert(currentAlerts.bullishBreakerBlock, sa_bb, true, 'Bullish breaker block confirmed')
f_smc_alert(currentAlerts.bearishBreakerBlock, sa_bb, false, 'Bearish breaker block confirmed')
