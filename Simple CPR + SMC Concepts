[o1Bull, o1Bear, o1Top, o1Bottom, o1Left, o1Time] = request.security(syminfo.tickerid, (showHTFOb1Input and htfOb1Valid) ? htfOb1Input : timeframe.period, htfObData(htfObImpulseInput), lookahead = barmerge.lookahead_off)
[o2Bull, o2Bear, o2Top, o2Bottom, o2Left, o2Time] = request.security(syminfo.tickerid, (showHTFOb2Input and htfOb2Valid) ? htfOb2Input : timeframe.period, htfObData(htfObImpulseInput), lookahead = barmerge.lookahead_off)
