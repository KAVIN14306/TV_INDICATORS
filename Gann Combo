barIsVisible() => time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time

degText(float d) => (d > 0 ? "+" : "") + str.tostring(d, "#.#") + " deg"

clampX(int x) => math.max(bar_index - MAX_PAST_BARS, math.min(bar_index + FUTURE_BARS, x))

