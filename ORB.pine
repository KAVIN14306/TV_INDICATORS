//@version=6
indicator(title = "ORB", shorttitle = "ORB", overlay = true, max_lines_count = 500, max_bars_back = 1000)

// =============================================================================
// GROUP: OPENING RANGE BREAKOUT
// =============================================================================
g_orb = "Opening Range Breakout"
enableOrb = input.bool(true, title = "Enable Opening Range Breakout", group = g_orb, tooltip = "Master switch for the whole Opening Range Breakout section. OFF hides the OR High/Low lines, breakout markers, price-scale/status-line values, the market detection label, and stops the ORB breakout alerts from firing.")
sessTime = input.session("0915-0930", title = "Opening Range Session", group = g_orb)

orHighCol    = input.color(color.new(color.green, 0), title = "OR High", group = g_orb)
orLowCol     = input.color(color.new(color.red, 0),   title = "OR Low",  group = g_orb)
showOrHigh   = input.bool(true, title = "Show OR High", group = g_orb)
showOrLow    = input.bool(true, title = "Show OR Low",  group = g_orb)
orbLineWidth = input.int(1, title = "ORB Line Width", minval = 1, maxval = 4, group = g_orb)

// =============================================================================
// GROUP: DISPLAY RANGE
// =============================================================================
g_style = "Style"
displayMode   = input.string("All Days", title = "Display Range", options = ["All Days", "Today Only"], group = g_style, tooltip = "All Days plots the OR lines/breaks on every historical day. Today Only shows just the current day's OR on the chart.")
continuousOrb = input.bool(false, title = "Continuous ORB Line (connect across days)", group = g_style, tooltip = "ON: OR High/Low draw as one continuous plot that visually joins each day's level to the next (the diagonal/vertical connector lines). OFF: each day's OR High/Low is drawn as its own separate, unconnected line segment.")

// =============================================================================
// GROUP: MARKET FILTER
// =============================================================================
g_market = "Market Filter"
restrictToIndia = input.bool(true, title = "Only Show on Indian Markets", group = g_market, tooltip = "Auto-detects Nifty 50, Bank Nifty, Fin Nifty, Sensex, GIFT Nifty, and NSE/BSE-listed stocks. Turn off to allow any symbol.")
showStatusLabel = input.bool(true, title = "Show Market Detection Label", group = g_market)

// ── Market detection ─────────────────────────────────────
// syminfo.country covers NSE/BSE/NFO/BFO/MCX/CDS and NSE IX (GIFT City),
// since all of those are registered as India ("IN"). Ticker-name matching
// is a fallback for feeds/brokers that report country differently for
// index or GIFT Nifty symbols.
tkr  = syminfo.ticker
exch = syminfo.prefix

isIndianCountry  = syminfo.country == "IN"
isIndianExchange = str.contains(exch, "NSE") or str.contains(exch, "BSE") or str.contains(exch, "MCX") or str.contains(exch, "NFO") or str.contains(exch, "BFO") or str.contains(exch, "CDS")
isIndianTicker   = str.contains(tkr, "NIFTY") or str.contains(tkr, "SENSEX") or str.contains(tkr, "BANKEX")

isIndianMarket = isIndianCountry or isIndianExchange or isIndianTicker
marketOk = not restrictToIndia or isIndianMarket

// ── Today-only filter ───────────────────────────────────
// Compares each bar's calendar date to the actual current date, so on a
// live/intraday chart "Today Only" always tracks the real current session.
isToday     = year(time) == year(timenow) and month(time) == month(timenow) and dayofmonth(time) == dayofmonth(timenow)
showThisBar = enableOrb and (displayMode == "All Days" or isToday) and marketOk

// =============================================================================
// ORB CALCULATION
// =============================================================================
inSession  = not na(time(timeframe.period, sessTime, "Asia/Kolkata"))
orbNewDay  = ta.change(time("D")) != 0

var float orHigh = na
var float orLow  = na
var bool  orDone = false

if orbNewDay
    orHigh := na
    orLow  := na
    orDone := false

if inSession
    orHigh := na(orHigh) ? high : math.max(orHigh, high)
    orLow  := na(orLow)  ? low  : math.min(orLow, low)

if not inSession and not orDone and not na(orHigh)
    orDone := true

// =============================================================================
// PLOTTING — continuous mode (single plot, connects across days; also gives price-scale label)
// =============================================================================
plot(showOrHigh and showThisBar and continuousOrb ? orHigh : na, title = "OR High (Continuous)", color = orHighCol, linewidth = orbLineWidth, style = plot.style_line, display = enableOrb and continuousOrb ? display.all : display.none)
plot(showOrLow  and showThisBar and continuousOrb ? orLow  : na, title = "OR Low (Continuous)",  color = orLowCol,  linewidth = orbLineWidth, style = plot.style_line, display = enableOrb and continuousOrb ? display.all : display.none)

// =============================================================================
// PLOTTING — segmented mode (separate line per day, no cross-day connector)
// =============================================================================
var line orHighLn = na
var line orLowLn  = na

if not continuousOrb
    if orbNewDay
        orHighLn := na
        orLowLn  := na

    if showThisBar and not na(orHigh)
        if showOrHigh
            if na(orHighLn)
                orHighLn := line.new(bar_index, orHigh, bar_index, orHigh, color = orHighCol, width = orbLineWidth)
            else
                line.set_y1(orHighLn, orHigh)
                line.set_xy2(orHighLn, bar_index, orHigh)
        if showOrLow
            if na(orLowLn)
                orLowLn := line.new(bar_index, orLow, bar_index, orLow, color = orLowCol, width = orbLineWidth)
            else
                line.set_y1(orLowLn, orLow)
                line.set_xy2(orLowLn, bar_index, orLow)

// Price-scale + status-line labels for segmented mode (the line.* drawings above have no
// native price-scale label, so this plot exists purely to put the value on the
// axis and status line — display.none when continuous mode is active so it stays silent).
plot(showOrHigh and showThisBar and not continuousOrb ? orHigh : na, title = "OR High (Scale Label)", color = orHighCol, display = enableOrb and not continuousOrb ? display.price_scale + display.status_line : display.none)
plot(showOrLow  and showThisBar and not continuousOrb ? orLow  : na, title = "OR Low (Scale Label)",  color = orLowCol,  display = enableOrb and not continuousOrb ? display.price_scale + display.status_line : display.none)

// =============================================================================
// BREAKOUTS & ALERTS
// =============================================================================
longBreak  = enableOrb and orDone and ta.crossover(close, orHigh)
shortBreak = enableOrb and orDone and ta.crossunder(close, orLow)

plotshape(longBreak and showThisBar,  title = "Bullish ORB Break", style = shape.triangleup,   location = location.belowbar, color = color.green, size = size.tiny, display = display.all - display.status_line)
plotshape(shortBreak and showThisBar, title = "Bearish ORB Break", style = shape.triangledown, location = location.abovebar, color = color.red,   size = size.tiny, display = display.all - display.status_line)

alertcondition(longBreak,  title = "ORB Bullish Breakout", message = "Nifty/Sensex,etc., broke above Opening Range High")
alertcondition(shortBreak, title = "ORB Bearish Breakout", message = "Nifty/Sensex,etc., broke below Opening Range Low")

// ── Status label ─────────────────────────────────────────
var table statusTbl = table.new(position.top_right, 1, 1)
if enableOrb and showStatusLabel and barstate.islast
    statusText  = marketOk ? "India Market: Detected - ORB Active" : "Non-Indian Chart - ORB Hidden"
    statusColor = marketOk ? color.new(color.green, 80) : color.new(color.red, 80)
    table.cell(statusTbl, 0, 0, statusText, text_color = marketOk ? color.green : color.red, bgcolor = statusColor, text_size = size.small)
