openEndH     = input.int(9,  "End",   minval=1, maxval=12, group=grpIndia, inline="openEnd")
openEndM     = input.int(30, "Min",   minval=0, maxval=59, group=grpIndia, inline="openEnd")
openEndAP    = input.string("AM", "", options=["AM", "PM"], group=grpIndia, inline="openEnd")
openColor    = input.color(color.blue, "Opening Start Line Color", group=grpIndia)
openEndColor = input.color(color.blue, "Opening End Line Color", group=grpIndia)
openBoxColor = input.color(color.blue, "Opening Box Color", group=grpIndia)

