htfObData(float impulseMult) =>
    float atrValue  = ta.atr(14)[1]
    float bodySize  = math.abs(close[1] - open[1])
    bool strongMove = impulseMult <= 0 or bodySize >= impulseMult * atrValue
    bool obBull     = close[2] < open[2] and close[1] > open[1] and close[1] > high[2] and strongMove
    bool obBear     = close[2] > open[2] and close[1] < open[1] and close[1] < low[2] and strongMove
    [obBull, obBear, high[2], low[2], time[2], time]

updateHtfOb(array<htfFairValueGap> obs, bool enabled, string tf, bool isNew, bool bull, bool bear, float oTop, float oBottom, int leftTime, color bullBorder, color bearBorder, color bullBox, color bearBox) =>
    if enabled
        if obs.size() > 0
            for i = obs.size() - 1 to 0
                htfFairValueGap g = obs.get(i)
                if g.active
                    bool mitigated = (g.bias == BULLISH and bullishOrderBlockMitigationSource < g.bottom) or (g.bias == BEARISH and bearishOrderBlockMitigationSource > g.top)
                    if mitigated
                        if htfObDeleteMitigatedInput
                            g.b_ox.delete()
                            g.l_abel.delete()
                            obs.remove(i)
                        else
                            g.active := false
                            g.b_ox.set_extend(extend.none)
                            g.b_ox.set_right(time)
                            updateHtfLabel(g, time)
                    else if htfObExtendInput
                        updateHtfLabel(g, time)

        if isNew and (bull or bear)
            int   biasValue   = bull ? BULLISH : BEARISH
            color borderColor = bull ? bullBorder : bearBorder
            color boxColor    = bull ? bullBox : bearBox
            string obText     = htfText(tf) + (bull ? ' Bull HTF OB' : ' Bear HTF OB')

            box newBox     = box.new(leftTime, oTop, time, oBottom, border_color = borderColor, bgcolor = boxColor, extend = htfObExtendInput ? extend.right : extend.none, xloc = xloc.bar_time)
            int labelTime  = htfObExtendInput ? time : math.round(0.5 * (leftTime + time))
            label newLabel = label.new(chart.point.new(labelTime, na, 0.5 * (oTop + oBottom)), htfObShowTextInput ? obText : '', xloc.bar_time, color = color(na), textcolor = color.new(borderColor, 0), style = label.style_label_center, size = htfObTextSizeInput)
            obs.push(htfFairValueGap.new(oTop, oBottom, biasValue, newBox, true, newLabel))

            if obs.size() > htfObMaxInput
                htfFairValueGap oldest = obs.shift()
                oldest.b_ox.delete()
                oldest.l_abel.delete()

// Instantly hides/shows already-plotted HTF FVG / HTF OB boxes when their bull/bear toggles change.
// Shared by both HTF FVG and HTF OB arrays since they use the same htfFairValueGap type.
syncHtfVisibility(array<htfFairValueGap> arr, bool showBull, bool showBear, color bullBorder, color bearBorder, color bullBox, color bearBox) =>
    if arr.size() > 0
        for eachG in arr
            bool visible       = eachG.bias == BULLISH ? showBull : showBear
            color borderColor  = eachG.bias == BULLISH ? bullBorder : bearBorder
            color boxColor     = eachG.bias == BULLISH ? bullBox : bearBox
            if visible
                eachG.b_ox.set_border_color(borderColor)
                eachG.b_ox.set_bgcolor(boxColor)
                eachG.l_abel.set_textcolor(color.new(borderColor,0))
            else
                eachG.b_ox.set_border_color(color(na))
                eachG.b_ox.set_bgcolor(color(na))
                eachG.l_abel.set_textcolor(color(na))

getStyle(string style) =>
    switch style
        SOLID => line.style_solid
        DASHED => line.style_dashed
        DOTTED => line.style_dotted

drawLevels(string timeframe, bool sameTimeframe, string style, color levelColor) =>
    [topLevel, bottomLevel, leftTime, rightTime] = request.security(syminfo.tickerid, timeframe, [high[1], low[1], time[1], time],lookahead = barmerge.lookahead_on)

    float parsedTop         = sameTimeframe ? high : topLevel
    float parsedBottom      = sameTimeframe ? low : bottomLevel    

    int parsedLeftTime      = sameTimeframe ? time : leftTime
    int parsedRightTime     = sameTimeframe ? time : rightTime

    int parsedTopTime       = time
    int parsedBottomTime    = time

    if not sameTimeframe
        int leftIndex               = times.binary_search_rightmost(parsedLeftTime)
        int rightIndex              = times.binary_search_rightmost(parsedRightTime)

        array<int> timeArray        = times.slice(leftIndex,rightIndex)
        array<float> topArray       = highs.slice(leftIndex,rightIndex)
        array<float> bottomArray    = lows.slice(leftIndex,rightIndex)

        parsedTopTime               := timeArray.size() > 0 ? timeArray.get(topArray.indexof(topArray.max())) : initialTime
        parsedBottomTime            := timeArray.size() > 0 ? timeArray.get(bottomArray.indexof(bottomArray.min())) : initialTime

    var line topLine        = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var line bottomLine     = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var label topLabel      = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}H',timeframe), color=color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)
    var label bottomLabel   = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}L',timeframe), color=color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)

    topLine.set_first_point(    chart.point.new(parsedTopTime,na,parsedTop))
    topLine.set_second_point(   chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedTop))   
    topLabel.set_point(         chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedTop))

    bottomLine.set_first_point( chart.point.new(parsedBottomTime,na,parsedBottom))    
    bottomLine.set_second_point(chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedBottom))
    bottomLabel.set_point(      chart.point.new(last_bar_time + 20 * (time-time[1]),na,parsedBottom))

higherTimeframe(string timeframe) => timeframe.in_seconds() > timeframe.in_seconds(timeframe)

updateTrailingExtremes() =>
    trailing.top            := math.max(high,trailing.top)
    trailing.lastTopTime    := trailing.top == high ? time : trailing.lastTopTime
    trailing.bottom         := math.min(low,trailing.bottom)
    trailing.lastBottomTime := trailing.bottom == low ? time : trailing.lastBottomTime

drawHighLowSwings() =>
