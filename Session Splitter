//@version=6
indicator("Session Splitter", overlay=true, max_bars_back=5000)

// ============================================================================
// HELPERS — 12H → 24H conversion (used to build session strings from manual inputs)
// ============================================================================
pad2(int n) =>
    string s = str.tostring(n)
    str.length(s) < 2 ? "0" + s : s

to24h(int h12, string ampm) =>
    int h = h12 % 12                 // 12 -> 0
    ampm == "PM" ? h + 12 : h

sessStr(int h1, int m1, string ap1, int h2, int m2, string ap2) =>
    pad2(to24h(h1, ap1)) + pad2(m1) + "-" + pad2(to24h(h2, ap2)) + pad2(m2)

// ============================================================================
// INPUTS
// ============================================================================
grpIndia = "India Sessions (enter times in 12H format)"
grpIntl  = "International Sessions (enter times in 12H format)"
grpStyle = "Style"
grpLabel = "Labels"

// ---- Opening ----
