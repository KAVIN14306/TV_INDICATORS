htfFvgData() =>
    bool bull   = low[1] > high[3] and close[2] > high[3]
    bool bear   = high[1] < low[3] and close[2] < low[3]
    [bull, bear, low[1], high[3], low[3], high[1], time[3], time]

htfText(string tf) =>
    int sec = timeframe.in_seconds(tf)
    string out = ''
    if sec % 86400 == 0
        int n = int(sec / 86400)
        out := str.tostring(n) + (n == 1 ? ' Day' : ' Days')
    else if sec % 3600 == 0
        int n = int(sec / 3600)
        out := str.tostring(n) + (n == 1 ? ' Hour' : ' Hours')
    else
        out := str.tostring(int(sec / 60)) + ' Min'
    out

updateHtfLabel(htfFairValueGap g, int x) =>
    g.l_abel.set_point(chart.point.new(x, na, 0.5 * (g.top + g.bottom)))

updateHtfFvg(array<htfFairValueGap> gaps, bool enabled, string tf, bool isNew, bool bull, bool bear, float bTop, float bBottom, float rTop, float rBottom, int leftTime, color bullBorder, color bearBorder, color bullBox, color bearBox) =>
    if enabled
        if gaps.size() > 0
            for i = gaps.size() - 1 to 0
                htfFairValueGap g = gaps.get(i)
                if g.active
                    bool mitigated = (g.bias == BULLISH and low < g.bottom) or (g.bias == BEARISH and high > g.top)
                    if mitigated
                        if htfDeleteMitigatedInput
                            g.b_ox.delete()
                            g.l_abel.delete()
                            gaps.remove(i)
                        else
                            g.active := false
                            g.b_ox.set_extend(extend.none)
                            g.b_ox.set_right(time)
                            updateHtfLabel(g, time)
                    else if htfExtendInput
                        updateHtfLabel(g, time)

        if isNew and (bull or bear)
            float topPrice    = bull ? bTop : rTop
            float bottomPrice = bull ? bBottom : rBottom
            int   biasValue   = bull ? BULLISH : BEARISH
            color borderColor = bull ? bullBorder : bearBorder
            color boxColor    = bull ? bullBox : bearBox
            string fvgText    = htfText(tf) + (bull ? ' Bull HTF FVG' : ' Bear HTF FVG')

            box newBox     = box.new(leftTime, topPrice, time, bottomPrice, border_color = borderColor, bgcolor = boxColor, extend = htfExtendInput ? extend.right : extend.none, xloc = xloc.bar_time)
            int labelTime  = htfExtendInput ? time : math.round(0.5 * (leftTime + time))
            label newLabel = label.new(chart.point.new(labelTime, na, 0.5 * (topPrice + bottomPrice)), htfShowTextInput ? fvgText : '', xloc.bar_time, color = color(na), textcolor = color.new(borderColor, 0), style = label.style_label_center, size = htfTextSizeInput)
            gaps.push(htfFairValueGap.new(topPrice, bottomPrice, biasValue, newBox, true, newLabel))

            if gaps.size() > htfMaxInput
                htfFairValueGap oldest = gaps.shift()
                oldest.b_ox.delete()
                oldest.l_abel.delete()

