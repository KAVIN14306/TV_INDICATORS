t_biasSuffix = t_biasMode == 'Pairs' and pair_label != '' ? ' on ' + pair_label : ''
t_tradeBiasCol = t_tradeBias == 'Bulls' ? color.green : t_tradeBias == 'Bears' ? color.red : color.gray

