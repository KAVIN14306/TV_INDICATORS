drawZone(float labelLevel, int labelIndex, float top, float bottom, string tag, color zoneColor, string style, bool visible, string labelSize) =>
    var label l_abel    = label.new(na,na,text = tag, color=color(na),textcolor = zoneColor, style = style, size = size.small)
    var box b_ox        = box.new(na,na,na,na,bgcolor = color.new(zoneColor,80),border_color = color(na), xloc = xloc.bar_time)

    if visible
        b_ox.set_top_left_point(    chart.point.new(trailing.barTime,na,top))
        b_ox.set_bottom_right_point(chart.point.new(last_bar_time,na,bottom))
        b_ox.set_bgcolor(           color.new(zoneColor,80))
        l_abel.set_point(           chart.point.new(na,labelIndex,labelLevel))
        // Show Zone Labels toggle: text is cleared and hidden when the checkbox is off
        l_abel.set_text(            showZoneLabelsInput ? tag : '')
        l_abel.set_textcolor(       showZoneLabelsInput ? zoneColor : color(na))
        l_abel.set_size(            labelSize)
    else
        b_ox.set_bgcolor(color(na))
        l_abel.set_text('')
        l_abel.set_textcolor(color(na))

drawPremiumDiscountZones() =>
    // Premium: label position unchanged
    drawZone(trailing.top, math.round(0.5*(trailing.barIndex + last_bar_index)), trailing.top, 0.95*trailing.top + 0.05*trailing.bottom, 'Premium', premiumZoneColor, label.style_label_down, showPremiumZoneInput, zoneLabelSizeInput)

    // Equilibrium: label now centered inside the box (horizontal middle of the box + vertical middle of the level)
    equilibriumLevel = math.avg(trailing.top, trailing.bottom)
    drawZone(equilibriumLevel, math.round(0.5*(trailing.barIndex + last_bar_index)), 0.525*trailing.top + 0.475*trailing.bottom, 0.525*trailing.bottom + 0.475*trailing.top, 'Equilibrium', equilibriumZoneColorInput, label.style_label_center, showEquilibriumZoneInput, zoneLabelSizeInput)

    // Discount: label position unchanged
    drawZone(trailing.bottom, math.round(0.5*(trailing.barIndex + last_bar_index)), 0.95*trailing.bottom + 0.05*trailing.top, trailing.bottom, 'Discount', discountZoneColor, label.style_label_up, showDiscountZoneInput, zoneLabelSizeInput)

