currentAlerts.htf1BullishOB := showHTFOb1Input and htfOb1Valid and o1New and o1Bull
currentAlerts.htf1BearishOB := showHTFOb1Input and htfOb1Valid and o1New and o1Bear
currentAlerts.htf2BullishOB := showHTFOb2Input and htfOb2Valid and o2New and o2Bull
