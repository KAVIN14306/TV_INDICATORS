    l_abel := label.new(chart.point.new(na, math.round(0.5 * (p_ivot.barIndex + bar_index)), p_ivot.currentLevel), tag, xloc.bar_index, color = color(na), textcolor = structureColor, style = labelStyle, size = labelSize)

deleteOrderBlocks(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    if orderBlocks.size() > 0
        for i = orderBlocks.size() - 1 to 0
            orderBlock eachOrderBlock = orderBlocks.get(i)
            bool crossedOderBlock = false
            if bearishOrderBlockMitigationSource > eachOrderBlock.barHigh and eachOrderBlock.bias == BEARISH
                crossedOderBlock := true
                if internal
                    currentAlerts.internalBearishOrderBlock := true
                else
                    currentAlerts.swingBearishOrderBlock := true
            else if bullishOrderBlockMitigationSource < eachOrderBlock.barLow and eachOrderBlock.bias == BULLISH
                crossedOderBlock := true
                if internal
                    currentAlerts.internalBullishOrderBlock := true
                else
                    currentAlerts.swingBullishOrderBlock := true
            if crossedOderBlock
                orderBlocks.remove(i)

storeOrdeBlock(pivot p_ivot, bool internal = false, int bias) =>
    if (not internal and showSwingOrderBlocksInput) or (internal and showInternalOrderBlocksInput)
        array<float> a_rray = na
        int parsedIndex = na
        int fromIndex = toBufIndex(p_ivot.barIndex)
        int toIndex = toBufIndex(bar_index)
        if bias == BEARISH
            a_rray := parsedHighs.slice(fromIndex, toIndex)
            parsedIndex := fromIndex + a_rray.indexof(a_rray.max())
        else
            a_rray := parsedLows.slice(fromIndex, toIndex)
            parsedIndex := fromIndex + a_rray.indexof(a_rray.min())
        orderBlock o_rderBlock = orderBlock.new(parsedHighs.get(parsedIndex), parsedLows.get(parsedIndex), times.get(parsedIndex), bias)
        array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
        if orderBlocks.size() >= 100
            orderBlocks.pop()
        orderBlocks.unshift(o_rderBlock)

drawOrderBlocks(bool internal = false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    array<label> l_abels = internal ? internalOrderBlocksLabels : swingOrderBlocksLabels
    orderBlocksSize = orderBlocks.size()
    if orderBlocksSize > 0
        maxOrderBlocks = internal ? internalOrderBlocksSizeInput : swingOrderBlocksSizeInput
        array<orderBlock> parsedOrdeBlocks = orderBlocks.slice(0, math.min(maxOrderBlocks, orderBlocksSize))
        array<box> b_oxes = internal ? internalOrderBlocksBoxes : swingOrderBlocksBoxes
        for [index, eachOrderBlock] in parsedOrdeBlocks
            orderBlockColor = styleInput == MONOCHROME ? (eachOrderBlock.bias == BEARISH ? color.new(MONO_BEARISH, 80) : color.new(MONO_BULLISH, 80)) : internal ? (eachOrderBlock.bias == BEARISH ? internalBearishOrderBlockColor : internalBullishOrderBlockColor) : (eachOrderBlock.bias == BEARISH ? swingBearishOrderBlockColor : swingBullishOrderBlockColor)
            bool biasVisible = eachOrderBlock.bias == BEARISH ? (internal ? showInternalBearishOBInput : showSwingBearishOBInput) : (internal ? showInternalBullishOBInput : showSwingBullishOBInput)
            box b_ox = b_oxes.get(index)
            label l_abel = l_abels.get(index)
            if biasVisible
                b_ox.set_top_left_point(chart.point.new(eachOrderBlock.barTime, na, eachOrderBlock.barHigh))
                b_ox.set_bottom_right_point(chart.point.new(last_bar_time, na, eachOrderBlock.barLow))
                b_ox.set_border_color(internal ? na : orderBlockColor)
                b_ox.set_bgcolor(orderBlockColor)
                l_abel.set_point(chart.point.new(na, last_bar_index, 0.5 * (eachOrderBlock.barHigh + eachOrderBlock.barLow)))
                l_abel.set_text(showObLabelsInput ? (eachOrderBlock.bias == BEARISH ? 'Bear OB' : 'Bull OB') : '')
                l_abel.set_textcolor(color.new(orderBlockColor, 0))
                l_abel.set_size(obLabelSizeInput)
            else
                b_ox.set_border_color(color(na))
                b_ox.set_bgcolor(color(na))
                l_abel.set_text('')
        if l_abels.size() > parsedOrdeBlocks.size()
            for i = parsedOrdeBlocks.size() to l_abels.size() - 1
                l_abels.get(i).set_text('')
    else
        for eachLabel in l_abels
            eachLabel.set_text('')

displayStructure(bool internal = false) =>
    var bullishBar = true
    var bearishBar = true
    if internalFilterConfluenceInput
        bullishBar := high - math.max(close, open) > math.min(close, open - low)
        bearishBar := high - math.max(close, open) < math.min(close, open - low)
    pivot p_ivot = internal ? internalHigh : swingHigh
    trend t_rend = internal ? internalTrend : swingTrend
    lineStyle = internal ? line.style_dashed : line.style_solid
    labelSize = internal ? internalStructureSize : swingStructureSize
    extraCondition = internal ? internalHigh.currentLevel != swingHigh.currentLevel and bullishBar : true
    bullishColor = styleInput == MONOCHROME ? MONO_BULLISH : internal ? internalBullColorInput : swingBullColorInput

    if ta.crossover(close, p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BEARISH ? CHOCH : BOS
        if internal
            currentAlerts.internalBullishCHoCH := tag == CHOCH
            currentAlerts.internalBullishBOS := tag == BOS
        else
            currentAlerts.swingBullishCHoCH := tag == CHOCH
            currentAlerts.swingBullishBOS := tag == BOS
        p_ivot.crossed := true
        t_rend.bias := BULLISH
        displayCondition = internal ? showInternalsInput and (showInternalBullInput == ALL or (showInternalBullInput == BOS and tag != CHOCH) or (showInternalBullInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBullInput == ALL or (showSwingBullInput == BOS and tag != CHOCH) or (showSwingBullInput == CHOCH and tag == CHOCH))
        if displayCondition
            drawStructure(p_ivot, tag, bullishColor, lineStyle, label.style_label_down, labelSize)
        if (internal and showInternalOrderBlocksInput) or (not internal and showSwingOrderBlocksInput)
            storeOrdeBlock(p_ivot, internal, BULLISH)

    p_ivot := internal ? internalLow : swingLow
    extraCondition := internal ? internalLow.currentLevel != swingLow.currentLevel and bearishBar : true
    bearishColor = styleInput == MONOCHROME ? MONO_BEARISH : internal ? internalBearColorInput : swingBearColorInput

    if ta.crossunder(close, p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BULLISH ? CHOCH : BOS
        if internal
            currentAlerts.internalBearishCHoCH := tag == CHOCH
            currentAlerts.internalBearishBOS := tag == BOS
        else
            currentAlerts.swingBearishCHoCH := tag == CHOCH
            currentAlerts.swingBearishBOS := tag == BOS
        p_ivot.crossed := true
        t_rend.bias := BEARISH
        displayCondition = internal ? showInternalsInput and (showInternalBearInput == ALL or (showInternalBearInput == BOS and tag != CHOCH) or (showInternalBearInput == CHOCH and tag == CHOCH)) : showStructureInput and (showSwingBearInput == ALL or (showSwingBearInput == BOS and tag != CHOCH) or (showSwingBearInput == CHOCH and tag == CHOCH))
        if displayCondition
            drawStructure(p_ivot, tag, bearishColor, lineStyle, label.style_label_up, labelSize)
        if (internal and showInternalOrderBlocksInput) or (not internal and showSwingOrderBlocksInput)
            storeOrdeBlock(p_ivot, internal, BEARISH)

// Fixed bar duration (not time - time[1]) so boxes don't stretch after overnight / weekend gaps
fairValueGapBox(leftTime, rightTime, topPrice, bottomPrice, boxColor) =>
    int barMs = timeframe.in_seconds(fairValueGapsTimeframeInput == '' ? timeframe.period : fairValueGapsTimeframeInput) * 1000
    box.new(chart.point.new(leftTime, na, topPrice), chart.point.new(rightTime + fairValueGapsExtendInput * barMs, na, bottomPrice), xloc = xloc.bar_time, border_color = boxColor, bgcolor = boxColor)

fvgTag(int bias) => bias == BULLISH ? 'Bull FVG' : 'Bear FVG'

updateFvgLabel(fairValueGap g) =>
    int boxLeft = g.leftTime
    int boxRight = g.topBox.get_right()
    g.l_abel.set_point(chart.point.new(math.round(0.5 * (boxLeft + boxRight)), na, 0.5 * (g.top + g.bottom)))

// Mitigation handling (backwards loop). remove(i) is called FIRST so both branches end with a void call (CE10235).
deleteFairValueGaps() =>
    if fairValueGaps.size() > 0
        for i = fairValueGaps.size() - 1 to 0
            fairValueGap eachFairValueGap = fairValueGaps.get(i)
            if eachFairValueGap.active
                bool mitigated = (low < eachFairValueGap.bottom and eachFairValueGap.bias == BULLISH) or (high > eachFairValueGap.top and eachFairValueGap.bias == BEARISH)
                if mitigated
                    if fvgDeleteMitigatedInput
                        fairValueGaps.remove(i)
                        eachFairValueGap.topBox.delete()
                        eachFairValueGap.bottomBox.delete()
                        eachFairValueGap.l_abel.delete()
                    else
                        eachFairValueGap.active := false
                        eachFairValueGap.topBox.set_right(time)
                        eachFairValueGap.bottomBox.set_right(time)
                        updateFvgLabel(eachFairValueGap)

syncFvgVisibility() =>
    if fairValueGaps.size() > 0
        for eachFairValueGap in fairValueGaps
            bool visible = eachFairValueGap.bias == BULLISH ? showBullishFVGInput : showBearishFVGInput
            color baseColor = eachFairValueGap.bias == BULLISH ? fairValueGapBullishColor : fairValueGapBearishColor
            color applied = visible ? baseColor : color(na)
            eachFairValueGap.topBox.set_border_color(applied)
            eachFairValueGap.topBox.set_bgcolor(applied)
            eachFairValueGap.bottomBox.set_border_color(applied)
            eachFairValueGap.bottomBox.set_bgcolor(applied)
            eachFairValueGap.l_abel.set_text(visible and showFvgLabelsInput ? fvgTag(eachFairValueGap.bias) : '')
            eachFairValueGap.l_abel.set_textcolor(color.new(baseColor, 0))
            eachFairValueGap.l_abel.set_size(fvgLabelSizeInput)

updateFvgStyle() =>
    if showFvgStyleInput and fairValueGaps.size() > 0
        for eachFairValueGap in fairValueGaps
            if eachFairValueGap.active
                eachFairValueGap.topBox.set_right(time)
                eachFairValueGap.bottomBox.set_right(time)
                updateFvgLabel(eachFairValueGap)

drawFairValueGaps() =>
    [lastClose, lastOpen, lastTime, currentHigh, currentLow, currentTime, last2High, last2Low] = request.security(syminfo.tickerid, fairValueGapsTimeframeInput, [close[1], open[1], time[1], high[0], low[0], time[0], high[2], low[2]], lookahead = barmerge.lookahead_on)
    barDeltaPercent = (lastClose - lastOpen) / (lastOpen * 100)
    newTimeframe = timeframe.change(fairValueGapsTimeframeInput)
    threshold = fairValueGapsThresholdInput ? ta.cum(math.abs(newTimeframe ? barDeltaPercent : 0)) / bar_index * 2 : 0
    bullishFairValueGap = currentLow > last2High and lastClose > last2High and barDeltaPercent > threshold and newTimeframe
    bearishFairValueGap = currentHigh < last2Low and lastClose < last2Low and -barDeltaPercent > threshold and newTimeframe

    if bullishFairValueGap
        currentAlerts.bullishFairValueGap := true
        label bullLabel = label.new(chart.point.new(currentTime, na, 0.5 * (currentLow + last2High)), showFvgLabelsInput ? fvgTag(BULLISH) : '', xloc.bar_time, color = color(na), textcolor = color.new(fairValueGapBullishColor, 0), style = label.style_label_center, size = fvgLabelSizeInput)
        fairValueGaps.unshift(fairValueGap.new(currentLow, last2High, BULLISH, fairValueGapBox(lastTime, currentTime, currentLow, math.avg(currentLow, last2High), fairValueGapBullishColor), fairValueGapBox(lastTime, currentTime, math.avg(currentLow, last2High), last2High, fairValueGapBullishColor), lastTime, true, bullLabel))
        updateFvgLabel(fairValueGaps.get(0))
    if bearishFairValueGap
        currentAlerts.bearishFairValueGap := true
        label bearLabel = label.new(chart.point.new(currentTime, na, 0.5 * (currentHigh + last2Low)), showFvgLabelsInput ? fvgTag(BEARISH) : '', xloc.bar_time, color = color(na), textcolor = color.new(fairValueGapBearishColor, 0), style = label.style_label_center, size = fvgLabelSizeInput)
        fairValueGaps.unshift(fairValueGap.new(currentHigh, last2Low, BEARISH, fairValueGapBox(lastTime, currentTime, currentHigh, math.avg(currentHigh, last2Low), fairValueGapBearishColor), fairValueGapBox(lastTime, currentTime, math.avg(currentHigh, last2Low), last2Low, fairValueGapBearishColor), lastTime, true, bearLabel))
        updateFvgLabel(fairValueGaps.get(0))

    // Max FVGs: newest are at the start, so the oldest are removed from the end
    while fairValueGaps.size() > fvgMaxInput
        fairValueGap oldest = fairValueGaps.pop()
        oldest.topBox.delete()
        oldest.bottomBox.delete()
        oldest.l_abel.delete()

// ——— HTF FVG ———
htfFvgData() =>
    bool bull = low[1] > high[3] and close[2] > high[3]
    bool bear = high[1] < low[3] and close[2] < low[3]
    [bull, bear, low[1], high[3], low[3], high[1], time[3], time]

htfText(string tf) =>
    int sec = timeframe.in_seconds(tf)
    string out = ''
    if sec % 86400 == 0
        int n = int(sec / 86400)
        out := str.tostring(n) + (n == 1 ? ' Day' : ' Days')
    else if sec % 3600 == 0
        int n = int(sec / 3600)
        out := str.tostring(n) + (n == 1 ? ' Hour' : ' Hours')
    else
        out := str.tostring(int(sec / 60)) + ' Min'
    out

updateHtfLabel(htfFairValueGap g, int x) =>
    g.l_abel.set_point(chart.point.new(x, na, 0.5 * (g.top + g.bottom)))

updateHtfFvg(array<htfFairValueGap> gaps, bool enabled, string tf, bool isNew, bool bull, bool bear, float bTop, float bBottom, float rTop, float rBottom, int leftTime, color bullBorder, color bearBorder, color bullBox, color bearBox) =>
    if enabled
        if gaps.size() > 0
            for i = gaps.size() - 1 to 0
                htfFairValueGap g = gaps.get(i)
                if g.active
                    bool mitigated = (g.bias == BULLISH and low < g.bottom) or (g.bias == BEARISH and high > g.top)
                    if mitigated
                        if htfDeleteMitigatedInput
                            gaps.remove(i)
                            g.b_ox.delete()
                            g.l_abel.delete()
                        else
                            g.active := false
                            g.b_ox.set_extend(extend.none)
                            g.b_ox.set_right(time)
                            updateHtfLabel(g, time)
                    else if htfExtendInput
                        updateHtfLabel(g, time)
        if isNew and (bull or bear)
            float topPrice = bull ? bTop : rTop
            float bottomPrice = bull ? bBottom : rBottom
            int biasValue = bull ? BULLISH : BEARISH
            color borderColor = bull ? bullBorder : bearBorder
            color boxColor = bull ? bullBox : bearBox
            string fvgText = htfText(tf) + (bull ? ' Bull HTF FVG' : ' Bear HTF FVG')
            box newBox = box.new(leftTime, topPrice, time, bottomPrice, border_color = borderColor, bgcolor = boxColor, extend = htfExtendInput ? extend.right : extend.none, xloc = xloc.bar_time)
            int labelTime = htfExtendInput ? time : math.round(0.5 * (leftTime + time))
            label newLabel = label.new(chart.point.new(labelTime, na, 0.5 * (topPrice + bottomPrice)), htfShowTextInput ? fvgText : '', xloc.bar_time, color = color(na), textcolor = color.new(borderColor, 0), style = label.style_label_center, size = htfTextSizeInput)
            gaps.push(htfFairValueGap.new(topPrice, bottomPrice, biasValue, newBox, true, newLabel))
            if gaps.size() > htfMaxInput
                htfFairValueGap oldest = gaps.shift()
                oldest.b_ox.delete()
                oldest.l_abel.delete()

// ——— HTF OB ———
htfObData(float impulseMult) =>
    float atrValue = ta.atr(14)[1]
    float bodySize = math.abs(close[1] - open[1])
    bool strongMove = impulseMult <= 0 or bodySize >= impulseMult * atrValue
    bool obBull = close[2] < open[2] and close[1] > open[1] and close[1] > high[2] and strongMove
    bool obBear = close[2] > open[2] and close[1] < open[1] and close[1] < low[2] and strongMove
    [obBull, obBear, high[2], low[2], time[2], time]

updateHtfOb(array<htfFairValueGap> obs, bool enabled, string tf, bool isNew, bool bull, bool bear, float oTop, float oBottom, int leftTime, color bullBorder, color bearBorder, color bullBox, color bearBox) =>
    if enabled
        if obs.size() > 0
            for i = obs.size() - 1 to 0
                htfFairValueGap g = obs.get(i)
                if g.active
                    bool mitigated = (g.bias == BULLISH and bullishOrderBlockMitigationSource < g.bottom) or (g.bias == BEARISH and bearishOrderBlockMitigationSource > g.top)
                    if mitigated
                        if htfObDeleteMitigatedInput
                            obs.remove(i)
                            g.b_ox.delete()
                            g.l_abel.delete()
                        else
                            g.active := false
                            g.b_ox.set_extend(extend.none)
                            g.b_ox.set_right(time)
                            updateHtfLabel(g, time)
                    else if htfObExtendInput
                        updateHtfLabel(g, time)
        if isNew and (bull or bear)
            int biasValue = bull ? BULLISH : BEARISH
            color borderColor = bull ? bullBorder : bearBorder
            color boxColor = bull ? bullBox : bearBox
            string obText = htfText(tf) + (bull ? ' Bull HTF OB' : ' Bear HTF OB')
            box newBox = box.new(leftTime, oTop, time, oBottom, border_color = borderColor, bgcolor = boxColor, extend = htfObExtendInput ? extend.right : extend.none, xloc = xloc.bar_time)
            int labelTime = htfObExtendInput ? time : math.round(0.5 * (leftTime + time))
            label newLabel = label.new(chart.point.new(labelTime, na, 0.5 * (oTop + oBottom)), htfObShowTextInput ? obText : '', xloc.bar_time, color = color(na), textcolor = color.new(borderColor, 0), style = label.style_label_center, size = htfObTextSizeInput)
            obs.push(htfFairValueGap.new(oTop, oBottom, biasValue, newBox, true, newLabel))
            if obs.size() > htfObMaxInput
                htfFairValueGap oldest = obs.shift()
                oldest.b_ox.delete()
                oldest.l_abel.delete()

// Instantly hides/shows already-plotted HTF FVG / HTF OB boxes when their bull/bear toggles change
syncHtfVisibility(array<htfFairValueGap> arr, bool showBull, bool showBear, color bullBorder, color bearBorder, color bullBox, color bearBox) =>
    if arr.size() > 0
        for eachG in arr
            bool visible = eachG.bias == BULLISH ? showBull : showBear
            color borderColor = eachG.bias == BULLISH ? bullBorder : bearBorder
            color boxColor = eachG.bias == BULLISH ? bullBox : bearBox
            if visible
                eachG.b_ox.set_border_color(borderColor)
                eachG.b_ox.set_bgcolor(boxColor)
                eachG.l_abel.set_textcolor(color.new(borderColor, 0))
            else
                eachG.b_ox.set_border_color(color(na))
                eachG.b_ox.set_bgcolor(color(na))
                eachG.l_abel.set_textcolor(color(na))

getStyle(string style) =>
    switch style
        SOLID => line.style_solid
        DASHED => line.style_dashed
        DOTTED => line.style_dotted

drawLevels(string timeframe, bool sameTimeframe, string style, color levelColor) =>
    [topLevel, bottomLevel, leftTime, rightTime] = request.security(syminfo.tickerid, timeframe, [high[1], low[1], time[1], time], lookahead = barmerge.lookahead_on)
    float parsedTop = sameTimeframe ? high : topLevel
    float parsedBottom = sameTimeframe ? low : bottomLevel
    int parsedLeftTime = sameTimeframe ? time : leftTime
    int parsedRightTime = sameTimeframe ? time : rightTime
    int parsedTopTime = time
    int parsedBottomTime = time
    if not sameTimeframe
        int leftIndex = times.binary_search_rightmost(parsedLeftTime)
        int rightIndex = times.binary_search_rightmost(parsedRightTime)
        array<int> timeArray = times.slice(leftIndex, rightIndex)
        array<float> topArray = highs.slice(leftIndex, rightIndex)
        array<float> bottomArray = lows.slice(leftIndex, rightIndex)
        parsedTopTime := timeArray.size() > 0 ? timeArray.get(topArray.indexof(topArray.max())) : initialTime
        parsedBottomTime := timeArray.size() > 0 ? timeArray.get(bottomArray.indexof(bottomArray.min())) : initialTime
    var line topLine = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var line bottomLine = line.new(na, na, na, na, xloc = xloc.bar_time, color = levelColor, style = getStyle(style))
    var label topLabel = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}H', timeframe), color = color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)
    var label bottomLabel = label.new(na, na, xloc = xloc.bar_time, text = str.format('P{0}L', timeframe), color = color(na), textcolor = levelColor, size = size.small, style = label.style_label_left)
    topLine.set_first_point(chart.point.new(parsedTopTime, na, parsedTop))
    topLine.set_second_point(chart.point.new(last_bar_time + 20 * (time - time[1]), na, parsedTop))
    topLabel.set_point(chart.point.new(last_bar_time + 20 * (time - time[1]), na, parsedTop))
    bottomLine.set_first_point(chart.point.new(parsedBottomTime, na, parsedBottom))
    bottomLine.set_second_point(chart.point.new(last_bar_time + 20 * (time - time[1]), na, parsedBottom))
    bottomLabel.set_point(chart.point.new(last_bar_time + 20 * (time - time[1]), na, parsedBottom))

higherTimeframe(string timeframe) => timeframe.in_seconds() > timeframe.in_seconds(timeframe)

updateTrailingExtremes() =>
    trailing.top := math.max(high, trailing.top)
    trailing.lastTopTime := trailing.top == high ? time : trailing.lastTopTime
    trailing.bottom := math.min(low, trailing.bottom)
    trailing.lastBottomTime := trailing.bottom == low ? time : trailing.lastBottomTime

drawHighLowSwings() =>
    var line topLine = line.new(na, na, na, na, color = swingBearishColor, xloc = xloc.bar_time)
